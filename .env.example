# TMPlayer build configuration, by example.
#
# Nothing in this file is needed to build and run the app. Every value is optional and each one
# turns on a feature that is off without it, which is the point: a fork, a pull request and a CI
# run all build cleanly with none of this present, and carry none of the project's own endpoints.
#
# Locally these belong in local.properties, which is gitignored, in properties form:
#
#   TG_API_ID=1234567
#   TG_API_HASH=...
#   SENTRY_DSN=https://...
#
# In CI they are repository secrets and reach the build as environment variables. Set them with
# the GitHub CLI, from the root of the repository:
#
#   gh secret set TG_API_ID
#   gh secret set TG_API_HASH
#   gh secret set SENTRY_DSN
#
# gh reads each value from the terminal without echoing it or putting it in your shell history.
# `gh secret list` shows what is set; the values themselves cannot be read back out.


# --- Telegram -------------------------------------------------------------------------------
#
# Your own free credentials from https://my.telegram.org. Without them the app compiles and runs
# and says so at the sign-in screen. They are per developer, not per project: do not use anybody
# else's, and do not put yours in a pull request.

TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef


# --- Crash reporting ------------------------------------------------------------------------
#
# The Sentry DSN that opted-in crash reports are sent to, from https://sentry.io, project settings,
# Client Keys. Leave it out and the whole feature is inert: the SDK is never initialised, and the
# "Send crash reports" switch is not drawn in Settings at all, which is what a fork should get.
#
# Even with it set, the switch is off on a fresh install and after signing out, and nothing is
# ever sent unless somebody turns it on. See app/src/main/java/com/tmplayer/data/CrashReports.kt
# for exactly what a report carries: a stack trace, the app version, the Android version and the
# device model, with no breadcrumbs, no sessions and no identifier that ties two reports together.
#
# A DSN is not a password. It ships inside the APK and anybody can read it out of one; it only
# grants the ability to send events to the project. Keeping it out of the repository is tidiness
# and rate-limit hygiene rather than secrecy.

SENTRY_DSN=https://examplepublickey@o0.ingest.sentry.io/0
