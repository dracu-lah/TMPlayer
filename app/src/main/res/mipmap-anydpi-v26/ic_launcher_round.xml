<?xml version="1.0" encoding="utf-8"?>
<!--
  Launchers that ask for the round icon get the same three layers. The mark already fits the
  circular mask, so there is nothing to draw differently here, but declaring the resource means a
  launcher looking for roundIcon finds an adaptive icon rather than falling back to a bitmap.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
