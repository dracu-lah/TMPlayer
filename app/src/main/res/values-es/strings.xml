    <string name="welcome_title">Te damos la bienvenida a TMPlayer</string>
    <string name="intro_body_phone">TMPlayer reproduce videos de tus propios chats de Telegram. Esto es lo que debes saber antes de iniciar sesión.</string>
    <string name="intro_body_tv">TMPlayer reproduce videos de tus propios chats de Telegram en este televisor. Esto es lo que debes saber antes de iniciar sesión.</string>
    <string name="intro_account_title">Tu sesión permanece abierta en tu propia cuenta</string>
    <string name="intro_account_phone">Al iniciar sesión, este dispositivo se agrega a tus dispositivos de Telegram, igual que una computadora. Tu contenido viene de Telegram y de ningún otro lugar.</string>
    <string name="intro_account_tv">Al iniciar sesión, este televisor se agrega a tus dispositivos de Telegram, igual que una computadora. Tu contenido viene de Telegram y de ningún otro lugar.</string>
    <string name="intro_videos_title">Solo videos, nunca tus mensajes</string>
    <string name="intro_videos_body">TMPlayer lee tus chats para mostrar los videos que contienen. Nunca muestra ni envía mensajes.</string>
    <string name="intro_cache_title_phone">Un video a la vez en este dispositivo</string>
    <string name="intro_cache_title_tv">Un video a la vez en este televisor</string>
    <string name="intro_cache_body_phone">TMPlayer guarda el video que estás viendo y lo elimina cuando inicias el siguiente, para no llenar el teléfono. Siempre te pregunta primero.</string>
    <string name="intro_cache_body_tv">TMPlayer guarda el video que estás viendo y lo elimina cuando inicias el siguiente, para no llenar el televisor. Siempre te pregunta primero.</string>
