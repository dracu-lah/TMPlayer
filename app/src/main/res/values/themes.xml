<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background prevents a white flash before Compose draws -->
    <style name="Theme.TMPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
    </style>

    <!--
      The phone's player: a plain full-screen dark window. The television overrides this with
      leanback's own theme in res/values-television, which is where the transport row reads its
      styling from. Running a phone on Theme.Leanback gave it the 10-foot control metrics and a
      window that knows nothing about a cutout.
    -->
    <style name="Theme.TMPlayer.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
