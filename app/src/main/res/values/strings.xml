    <string name="welcome_title">Welcome to TMPlayer</string>
    <string name="intro_body_phone">TMPlayer plays videos from your own Telegram chats. Here\'s what that means before you sign in.</string>
    <string name="intro_body_tv">TMPlayer plays videos from your own Telegram chats on this TV. Here\'s what that means before you sign in.</string>
    <string name="intro_account_title">You stay signed in to your own account</string>
    <string name="intro_account_phone">Signing in adds this device to your Telegram devices, just like a computer does. Your media comes from Telegram and nowhere else.</string>
    <string name="intro_account_tv">Signing in adds this TV to your Telegram devices, just like a computer does. Your media comes from Telegram and nowhere else.</string>
    <string name="intro_videos_title">Videos only, never your messages</string>
    <string name="intro_videos_body">TMPlayer reads your chats to list the videos in them. It never shows messages, and it never sends any.</string>
    <string name="intro_cache_title_phone">One video on this device at a time</string>
    <string name="intro_cache_title_tv">One video on this TV at a time</string>
    <string name="intro_cache_body_phone">TMPlayer saves the video you\'re watching and deletes it when you start the next one, so this phone doesn\'t fill up. It always asks you first.</string>
    <string name="intro_cache_body_tv">TMPlayer saves the video you\'re watching and deletes it when you start the next one, so this TV doesn\'t fill up. It always asks you first.</string>
