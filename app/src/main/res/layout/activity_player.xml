<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Leanback's own playback fragment: video surface plus the whole transport UI. -->
    <FrameLayout
        android:id="@+id/playback_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Sits above the video but below any dialog. The bottom margin is overscan clearance, not
      transport clearance: leanback's control row is around 150dp tall, so nothing sensible fits
      under it and subtitles are simply covered while it is raised. 48dp keeps descenders off a
      TV's crop boundary, which the old 24dp did not; the overscan inset alone is 20dp.
    -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="48dp" />

    <!--
      Full-screen while the video opens: an opaque sheet, not a spinner floating over a black
      surface, so there is never a moment that reads as "nothing is happening".

      Fully opaque, with no alpha at all. At 94 per cent the first frames of the video showed
      through behind the text, which does not read as a deliberate scrim, only as a sheet that
      has not finished drawing.
    -->
    <LinearLayout
        android:id="@+id/status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0E12"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="72dp"
        android:paddingRight="72dp">

        <!--
          Shown only when the overlay is carrying an error, so the loading screen and the failure
          screen are told apart at a glance from across a room.
        -->
        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning"
            android:tint="#E5484D"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:maxWidth="820dp"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:textColor="#9A9AA5"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/status_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="520dp"
            android:layout_height="8dp"
            android:max="1000"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/status_spinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/accent" />
    </LinearLayout>

    <!--
      How much of the video has arrived, shown only while the transport controls are up. That is
      when the question gets asked, and it keeps a permanent figure off the picture the rest of
      the time. Declared before the rebuffer chip so that one draws over it in the rare frame
      where both are up.
    -->
    <TextView
        android:id="@+id/download_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="#17171E"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!--
      Mid-video rebuffering gets a corner chip instead. Covering the picture with a full sheet
      every time the connection hiccups would be far more intrusive than the pause itself.
    -->
    <LinearLayout
        android:id="@+id/rebuffer_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="#17171E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/rebuffer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!--
      What a touch gesture is doing, while it is doing it: the jump, the brightness, the volume.
      A drag on a phone changes something the picture itself cannot show, so without a figure on
      screen the viewer is adjusting blind. Never raised on a TV, which has buttons for all three.
    -->
    <TextView
        android:id="@+id/gesture_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#17171E"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Track pickers are added here so they cover the video, not the other way round. -->
    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
