<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Leanback's own playback fragment: video surface plus the whole transport UI. -->
    <FrameLayout
        android:id="@+id/playback_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Sits above the video but below any dialog. The bottom margin is overscan clearance, not
      transport clearance: leanback's control row is around 150dp tall, so nothing sensible fits
      under it and subtitles are simply covered while it is raised. 48dp keeps descenders off a
      TV's crop boundary, which the old 24dp did not; the overscan inset alone is 20dp.
    -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/player_subtitle_bottom" />

    <!--
      Full-screen while the video opens: an opaque sheet, not a spinner floating over a black
      surface, so there is never a moment that reads as "nothing is happening".

      Fully opaque, with no alpha at all. At 94 per cent the first frames of the video showed
      through behind the text, which does not read as a deliberate scrim, only as a sheet that
      has not finished drawing.
    -->
    <LinearLayout
        android:id="@+id/status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0E12"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/player_sheet_side"
        android:paddingRight="@dimen/player_sheet_side">

        <!--
          Shown only when the overlay is carrying an error, so the loading screen and the failure
          screen are told apart at a glance from across a room.
        -->
        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning"
            android:tint="#E5484D"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:maxWidth="820dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/player_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:textColor="#9A9AA5"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/status_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/player_progress_width"
            android:layout_height="8dp"
            android:max="1000"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/status_detail"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/status_spinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/accent" />

        <!--
          The error sheet's way out. Before this it said "Press Back to pick something else" and
          offered nothing focusable at all, so on a remote the whole screen took no input: a video
          that failed on a moved download window, which the next attempt would have played, was
          simply the end of the session.
        -->
        <Button
            android:id="@+id/status_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="160dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:text="Try again"
            android:textColor="@color/text_primary"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      Everything that floats in the top right corner, in one column.

      The download figure, the rebuffer chip and the episode buttons were three separate views all
      pinned to the same corner, which was survivable only because they were rarely up at the same
      moment: put the episode buttons on the right, where they belong, and two of them land on top
      of each other. Stacking them means the corner can hold all three at once and they simply move
      down the screen instead of over one another.

      The left of the top edge belongs to Media3's own controls, the back arrow and the title.
    -->
    <LinearLayout
        android:id="@+id/top_right_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/player_chip_margin"
        android:gravity="end"
        android:orientation="vertical">

        <!--
          How much of the video has arrived, shown only while the transport controls are up. That
          is when the question gets asked, and it keeps a permanent figure off the picture the rest
          of the time.
        -->
        <TextView
            android:id="@+id/download_chip"
            android:accessibilityLiveRegion="polite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_chip"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
          Mid-video rebuffering gets a corner chip instead. Covering the picture with a full sheet
          every time the connection hiccups would be far more intrusive than the pause itself.
        -->
        <LinearLayout
            android:id="@+id/rebuffer_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_player_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/rebuffer_text"
                android:accessibilityLiveRegion="polite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!--
          The phone's own controls: the episodes either side of this one, the picture shape and the
          playback speed.

          The episode search already ran on every device; on a phone its result was simply thrown
          away, because the only thing consuming it was leanback's transport row and a phone has
          none. Shape and speed were reachable only by pinching and by digging through Media3's
          gear menu, which is to say most viewers never found either.

          All of it rides with Media3's controller: it appears when the controller does and goes
          with it, so none of it is ever over the picture on its own. The labels are written at
          runtime, so the text here is only what a preview renders.
        -->
        <LinearLayout
            android:id="@+id/episode_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/previous_episode"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_player_button"
                android:minWidth="0dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Prev"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:visibility="gone" />

            <Button
                android:id="@+id/next_episode"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button"
                android:minWidth="0dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/picture_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/scale_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_player_button"
                android:minWidth="0dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Fit"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/speed_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_button"
                android:minWidth="0dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="1x"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!--
      What a touch gesture is doing, while it is doing it: the jump, the brightness, the volume.
      A drag on a phone changes something the picture itself cannot show, so without a figure on
      screen the viewer is adjusting blind. Never raised on a TV, which has buttons for all three.
    -->
    <TextView
        android:id="@+id/gesture_hud"
        android:accessibilityLiveRegion="polite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_chip"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />


    <!-- Track pickers are added here so they cover the video, not the other way round. -->
    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
