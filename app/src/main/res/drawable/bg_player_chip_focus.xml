<!--
  The television's skip pill when the remote stands on it (row up): the chip turns solid white, the
  same answer the round buttons and the time readout give, so the focus is not missed over a frame.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_player_chip" />
</selector>
