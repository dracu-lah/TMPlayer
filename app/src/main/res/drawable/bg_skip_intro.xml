<!--
  The Skip intro pill: bg_player_chip's translucent slab with a white edge, so it reads as
  something to press rather than a notice, and a ripple for a thumb.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC101014" />
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
