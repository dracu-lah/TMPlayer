<!--
  The dark wash under the transport row.

  White glyphs and a thin scrub bar sitting on a bright frame are close to unreadable, and the
  usual answer, painting a panel behind them, hides part of the film. A gradient from nothing to
  near-black does the job without a visible edge: the picture is still there under the controls,
  and it is only dimmed where something has to be read off it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#00000000"
        android:startColor="#CC000000"
        android:type="linear" />
</shape>
