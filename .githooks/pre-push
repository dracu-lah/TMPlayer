#!/usr/bin/env bash
# Runs the checks CI used to run on every push (scripts/ci-local.sh). Install once with
# `git config core.hooksPath .githooks`. Skip with SKIP_LOCAL_CI=1 set before the push.
# Only a push that sends no branch (tags alone, or a branch deletion) has nothing to test here.
# It tests the checkout, not the pushed commit, so push from the branch you are on.
branch=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/tags/*|"(delete)") ;; *) branch=1 ;; esac
done
[ "$branch" = 1 ] || exit 0
exec "$(git rev-parse --show-toplevel)/scripts/ci-local.sh"
