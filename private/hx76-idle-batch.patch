+/**
+ * Posts work to the main thread between frames: [afterThisFrame] once the frame being built is
+ * drawn (a view's post), [afterNextFrame] once one more frame has gone by. A platform without one
+ * (the desktop) answers null from [rememberFramePoster].
+ */
+@OptIn(ExperimentalFoundationApi::class) // AB-TEMP
+internal interface FramePoster {
+    fun afterThisFrame(task: Runnable)
+    fun afterNextFrame(task: Runnable)
+    fun cancel(task: Runnable)
+
+    /** False while the window is hidden or gone: nothing is composed for a screen nobody sees. */
+    val showing: Boolean
+
+    // AB-TEMP
+    fun platformScheduler(): PrefetchScheduler? = null
+    fun batchOn(): Boolean = true
+}
+
+/**
+ * Runs a list's prefetch in batches in the idle time after a frame (HX76), instead of the
+ * platform's way of fitting one step of one row into what is left of each frame. Each step of a
+ * row (its composition, its measure) asks for a redraw of the whole list, because the row is not
+ * placed and the request climbs to the list's layer; on the Mi TV each of those frames re-recorded
+ * the list (about 11 ms in debug), and since a frame was drawn the platform's scheduler then gave
+ * the next step only a frame's leftover, so a row composed ahead cost one or two frames of its own.
+ * Here every step that fits in [capNanos] runs in one go, so a batch costs one frame. A key pressed
+ * during a batch waits up to the cap (the first row of a batch always runs whole, so one row more).
+ */
+@Suppress("DEPRECATION") // PrefetchScheduler: still read by LazyLayout in 1.12
+@OptIn(ExperimentalFoundationApi::class)
+internal class IdleBatchScheduler(private val poster: FramePoster, capNanos: Long) : PrefetchScheduler {
+    private val batch = IdleBatch<PrefetchRequest>(capNanos, System::nanoTime)
+    private val scope = Scope()
+
+    private val run = object : Runnable {
+        override fun run() {
+            if (!poster.showing) {
+                batch.park()
+                return
+            }
+            val more = batch.run { request, available ->
+                scope.available = available
+                with(request) { scope.execute() }
+            }
+            if (more) poster.afterNextFrame(this)
+        }
+    }
+
+    override fun schedulePrefetch(prefetchRequest: PrefetchRequest) {
+        // AB-TEMP
+        val platform = poster.platformScheduler()
+        if (platform != null && !poster.batchOn()) {
+            platform.schedulePrefetch(prefetchRequest)
+            return
+        }
+        if (batch.add(prefetchRequest)) poster.afterThisFrame(run)
+    }
+
+    fun stop() {
+        poster.cancel(run)
+        batch.clear()
+    }
+
+    private class Scope : PrefetchRequestScope {
+        var available: () -> Long = { 0L }
+        override fun availableTimeNanos(): Long = available()
+    }
+}
+
+/**
+ * The queue [IdleBatchScheduler] runs, kept apart from Compose's sealed requests so it can be
+ * tested. Bounded by its caller: [JumpAheadPrefetch] asks for a screenful at most per move.
+ */
+internal class IdleBatch<T : Any>(private val capNanos: Long, private val now: () -> Long) {
+    private val queue = ArrayDeque<T>()
+
+    /** A batch is posted and has not run yet. */
+    var posted = false
+        private set
+
+    /** Queues [task]; true when the caller must post a batch (none is waiting). */
+    fun add(task: T): Boolean {
+        queue.addLast(task)
+        if (posted) return false
+        posted = true
+        return true
+    }
+
+    /**
+     * One batch: the first task runs whole (given all the time it asks for, so a batch always gets
+     * somewhere), the rest while the cap lasts; a task that ran out of time stays first for the
+     * next batch. True when tasks remain, so the caller posts the next batch a frame later.
+     */
+    fun run(execute: (task: T, available: () -> Long) -> Boolean): Boolean {
+        val deadline = now() + capNanos
+        val unbounded: () -> Long = { Long.MAX_VALUE }
+        val bounded: () -> Long = { maxOf(0L, deadline - now()) }
+        var first = true
+        while (true) {
+            val task = queue.firstOrNull() ?: break
+            if (!first && bounded() <= 0L) break
+            val more = execute(task, if (first) unbounded else bounded)
+            first = false
+            if (more) break
+            queue.removeFirst()
+        }
+        posted = queue.isNotEmpty()
+        return posted
+    }
+
+    /** The window is hidden: the tasks wait, and the next one added posts a batch again. */
+    fun park() {
+        posted = false
+    }
+
+    fun clear() {
+        queue.clear()
+        posted = false
+    }
+}
