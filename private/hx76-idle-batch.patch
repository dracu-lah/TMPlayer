+package com.tmplayer.ui.components
+
+import android.view.Choreographer
+import android.view.View
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.platform.LocalView
+
+/**
+ * The view's own queue: a post waits behind the traversal a frame has asked for, so it runs once
+ * that frame is drawn (the platform's prefetch scheduler posts the same way); the next frame is
+ * waited for with the choreographer.
+ */
+@Composable
+internal fun rememberFramePoster(): FramePoster? {
+    val view = LocalView.current
+    return remember(view) { ViewFramePoster(view) }
+}
+
+@OptIn(androidx.compose.foundation.ExperimentalFoundationApi::class) // AB-TEMP
+private class ViewFramePoster(private val view: View) : FramePoster {
+    private val choreographer = Choreographer.getInstance()
+    private val waiting = HashMap<Runnable, Choreographer.FrameCallback>()
+
+    override fun afterThisFrame(task: Runnable) {
+        view.post(task)
+    }
+
+    override fun afterNextFrame(task: Runnable) {
+        val callback = waiting.getOrPut(task) {
+            Choreographer.FrameCallback {
+                waiting.remove(task)
+                view.post(task)
+            }
+        }
+        choreographer.removeFrameCallback(callback)
+        choreographer.postFrameCallback(callback)
+    }
+
+    override fun cancel(task: Runnable) {
+        view.removeCallbacks(task)
+        waiting.remove(task)?.let(choreographer::removeFrameCallback)
+    }
+
+    override val showing: Boolean
+        get() = view.isAttachedToWindow && view.windowVisibility == View.VISIBLE
+
+    // AB-TEMP
+    @Suppress("DEPRECATION")
+    private val platform: androidx.compose.foundation.lazy.layout.PrefetchScheduler? by lazy {
+        runCatching {
+            Class.forName("androidx.compose.foundation.lazy.layout.AndroidPrefetchScheduler")
+                .getDeclaredConstructor(View::class.java).apply { isAccessible = true }
+                .newInstance(view) as androidx.compose.foundation.lazy.layout.PrefetchScheduler
+        }.onFailure { android.util.Log.e("AB", "no platform scheduler", it) }.getOrNull()
+    }
+
+    @Suppress("DEPRECATION")
+    override fun platformScheduler() = platform
+
+    override fun batchOn(): Boolean = runCatching {
+        Class.forName("android.os.SystemProperties").getMethod("get", String::class.java, String::class.java)
+            .invoke(null, "debug.tm.batch", "1") as String != "0"
+    }.getOrDefault(true)
+}
