+package com.tmplayer.ui.components
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The TV's prefetch batches (HX76): rows composed ahead run in one go after a frame, up to a cap,
+ * so a batch costs one frame instead of a frame per step. A fake clock: each task "takes" the time
+ * it is given here. Whether it saves frames on the Mi TV is measured there.
+ */
+class IdleBatchTest {
+    private var clock = 0L
+    private val batch = IdleBatch<String>(capNanos = 40, now = { clock })
+
+    /** Runs a batch where each task takes [cost] and finishes if the time it was given covers it. */
+    private fun runBatch(cost: Map<String, Long>, ran: MutableList<String> = ArrayList()): Boolean =
+        batch.run { task, available ->
+            val needs = cost.getValue(task)
+            if (available() < needs) {
+                true
+            } else {
+                clock += needs
+                ran += task
+                false
+            }
+        }
+
+    @Test
+    fun `one batch is posted however many tasks come before it runs`() {
+        assertTrue(batch.add("a"))
+        assertFalse(batch.add("b"))
+        assertFalse(batch.add("c"))
+        val ran = ArrayList<String>()
+        assertFalse(runBatch(mapOf("a" to 5L, "b" to 5L, "c" to 5L), ran))
+        assertEquals(listOf("a", "b", "c"), ran)
+        assertFalse(batch.posted)
+        assertTrue("an empty queue posts again", batch.add("d"))
+    }
+
+    @Test
+    fun `the cap stops a batch and the rest wait for the next one in order`() {
+        val cost = mapOf("a" to 15L, "b" to 15L, "c" to 15L, "d" to 15L)
+        for (task in cost.keys) batch.add(task)
+        val ran = ArrayList<String>()
+        assertTrue(runBatch(cost, ran))
+        assertEquals("c needs 15 with 10 left", listOf("a", "b"), ran)
+        assertTrue(batch.posted)
+        ran.clear()
+        assertFalse(runBatch(cost, ran))
+        assertEquals(listOf("c", "d"), ran)
+    }
+
+    @Test
+    fun `the first task of a batch always runs whole, even past the cap`() {
+        val cost = mapOf("slow" to 100L, "next" to 1L)
+        batch.add("slow")
+        batch.add("next")
+        val ran = ArrayList<String>()
+        assertTrue(runBatch(cost, ran))
+        assertEquals("nothing after a task that spent the cap", listOf("slow"), ran)
+        ran.clear()
+        assertFalse(runBatch(cost, ran))
+        assertEquals(listOf("next"), ran)
+    }
+
+    @Test
+    fun `a hidden window parks the queue and the next task posts again`() {
+        batch.add("a")
+        batch.park()
+        assertTrue(batch.add("b"))
+        val ran = ArrayList<String>()
+        assertFalse(runBatch(mapOf("a" to 1L, "b" to 1L), ran))
+        assertEquals(listOf("a", "b"), ran)
+    }
+
+    @Test
+    fun `clear drops what waits`() {
+        batch.add("a")
+        batch.clear()
+        val ran = ArrayList<String>()
+        assertFalse(runBatch(emptyMap(), ran))
+        assertTrue(ran.isEmpty())
+    }
+}
