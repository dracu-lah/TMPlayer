<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: what GNOME Software, KDE Discover and Flathub show for the app. -->
<component type="desktop-application">
  <id>io.github.dracu_lah.TMPlayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>TMPlayer</name>
  <summary>Watch the videos in your Telegram chats while they download</summary>
  <developer id="io.github.dracu_lah">
    <name>dracu-lah</name>
  </developer>
  <description>
    <p>
      TMPlayer plays the videos in your own Telegram chats and channels. It starts within seconds
      while the file is still downloading, and seeking re-aims the download instead of waiting
      for it.
    </p>
    <ul>
      <li>Sign in with a QR code or your phone number</li>
      <li>Browse the videos in every chat as a poster grid, with what you were watching first</li>
      <li>Resume where you stopped, and go on to the next episode</li>
      <li>Embedded subtitles and audio tracks, drawn by libmpv</li>
      <li>Full keyboard and mouse control, media keys and MPRIS</li>
    </ul>
    <p>
      TMPlayer is an unofficial client. It is not made by or affiliated with Telegram.
    </p>
  </description>
  <launchable type="desktop-id">io.github.dracu_lah.TMPlayer.desktop</launchable>
  <url type="homepage">https://tmplayer.org</url>
  <url type="bugtracker">https://github.com/dracu-lah/TMPlayer/issues</url>
  <url type="vcs-browser">https://github.com/dracu-lah/TMPlayer</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>Telegram</keyword>
    <keyword>Video</keyword>
    <keyword>Stream</keyword>
  </keywords>
  <provides>
    <binary>tmplayer</binary>
  </provides>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <!-- package.sh fills in the version being built and its date. -->
  <releases>
    <release version="@VERSION@" date="@DATE@">
      <url type="details">https://github.com/dracu-lah/TMPlayer/releases</url>
    </release>
  </releases>
</component>
