+// HAL_PIXEL_FORMAT_YV12: Y, then V, then U; the chroma stride is the luma stride halved and
+// aligned to 16. Media3's own libvpx and libgav1 renderers write it the same way.
+constexpr int kHalPixelFormatYv12 = 0x32315659;
+
+// ADataSpace bits (android/data_space.h, API 28): the standard, the transfer and the range.
+constexpr int32_t kDataSpaceBt709 = 1 << 16;
+constexpr int32_t kDataSpaceBt601_625 = 2 << 16;
+constexpr int32_t kDataSpaceBt601_525 = 4 << 16;
+constexpr int32_t kDataSpaceBt2020 = 6 << 16;
+constexpr int32_t kDataSpaceTransferSmpte170m = 3 << 22;
+constexpr int32_t kDataSpaceRangeLimited = 2 << 27;
+
+// The YV12 frame's matrix, for the compositor: the same choice as GetOutputColorspace and the
+// RGBA path (BT.709 when unknown), with the transfer left as the RGBA path leaves it.
+static int32_t DataSpaceOf(const AVFrame *frame) {
+    int32_t standard;
+    switch (frame->colorspace) {
+        case AVCOL_SPC_BT470BG: standard = kDataSpaceBt601_625; break;
+        case AVCOL_SPC_SMPTE170M: standard = kDataSpaceBt601_525; break;
+        case AVCOL_SPC_BT2020_NCL: standard = kDataSpaceBt2020; break;
+        default: standard = kDataSpaceBt709; break;
+    }
+    return standard | kDataSpaceTransferSmpte170m | kDataSpaceRangeLimited;
+}
+
+// ANativeWindow_setBuffersDataSpace, which libandroid has from API 28 on; null before.
+static int32_t SetBuffersDataSpace(ANativeWindow *window, int32_t dataSpace) {
+    using Setter = int32_t (*)(ANativeWindow *, int32_t);
+    static const Setter setter = reinterpret_cast<Setter>(
