+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+#include <arm_neon.h>
+#endif
+
+namespace fflight {
+
+// 10-bit samples to 8-bit, rounded to nearest and saturated (1023 gives 255).
+inline void Reduce10To8(const uint16_t *__restrict src, uint8_t *__restrict dst, int count) {
+    int i = 0;
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+    for (; i + 16 <= count; i += 16) {
+        const uint16x8_t a = vld1q_u16(src + i);
+        const uint16x8_t b = vld1q_u16(src + i + 8);
+        vst1q_u8(dst + i, vcombine_u8(vqrshrn_n_u16(a, 2), vqrshrn_n_u16(b, 2)));
+    }
+#endif
+    for (; i < count; i++) {
+        const unsigned value = (src[i] + 2u) >> 2;
+        dst[i] = static_cast<uint8_t>(value > 255u ? 255u : value);
+    }
+}
+
+// Whether CopyTo420 takes this frame: planar 4:2:0, 8 or 10 bits, limited range.
+inline bool CanCopyTo420(const AVFrame *frame) {
+    if (frame->color_range == AVCOL_RANGE_JPEG) return false;
+    return frame->format == AV_PIX_FMT_YUV420P || frame->format == AV_PIX_FMT_YUV420P10LE;
+}
+
+// Writes the frame's Y, U and V planes as 8-bit samples to dest[0..2] with the given strides.
+// Returns false, writing nothing, for a frame CanCopyTo420 refuses.
+inline bool CopyTo420(const AVFrame *frame, uint8_t *const dest[3], const int strides[3]) {
+    if (!CanCopyTo420(frame)) return false;
+    const bool ten = frame->format == AV_PIX_FMT_YUV420P10LE;
+    for (int plane = 0; plane < 3; plane++) {
+        const int width = plane ? (frame->width + 1) / 2 : frame->width;
+        const int height = plane ? (frame->height + 1) / 2 : frame->height;
+        for (int y = 0; y < height; y++) {
+            const uint8_t *src = frame->data[plane] + static_cast<ptrdiff_t>(y) * frame->linesize[plane];
+            uint8_t *dst = dest[plane] + static_cast<ptrdiff_t>(y) * strides[plane];
+            if (ten) {
+                Reduce10To8(reinterpret_cast<const uint16_t *>(src), dst, width);
+            } else {
+                memcpy(dst, src, width);
+            }
+        }
+    }
+    return true;
+}
+
+}  // namespace fflight
+
+#endif  // TMPLAYER_FFLIGHT_H
