+// TMPlayer (tm3): what a container tells a decoder before the first packet, for the decoders
+// TMPlayer's patch adds. Kept apart, and free of JNI, so the host test (TMPlayer's
+// scripts/media3ext/bench, "codec" mode) runs the very code the app runs.
+//
+// Nextlib's own decoders (H.264, HEVC, AAC, AC-3, ...) work from their in-band headers and from the
+// extra data alone, and are left exactly as they were: Legacy*() names them. The old and the
+// exotic formats added in tm3 mostly cannot: a WMA or ADPCM stream has its sample rate, channel
+// count and block size only in the container, and a Cinepak, RealVideo or WMV picture its size.
+#ifndef TMPLAYER_FFCODECPARAMS_H
+#define TMPLAYER_FFCODECPARAMS_H
+
+#include <cstdint>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/channel_layout.h>
+}
+
+namespace ffparams {
+
+// Decoders nextlib and TMPlayer's earlier revisions (tm1, tm2) already ran: untouched.
+inline bool LegacyAudio(AVCodecID id) {
+    switch (id) {
+        case AV_CODEC_ID_AAC:
+        case AV_CODEC_ID_MP3:
+        case AV_CODEC_ID_AC3:
+        case AV_CODEC_ID_EAC3:
+        case AV_CODEC_ID_TRUEHD:
+        case AV_CODEC_ID_MLP:
+        case AV_CODEC_ID_DTS:
+        case AV_CODEC_ID_VORBIS:
+        case AV_CODEC_ID_OPUS:
+        case AV_CODEC_ID_AMR_NB:
+        case AV_CODEC_ID_AMR_WB:
+        case AV_CODEC_ID_FLAC:
+        case AV_CODEC_ID_ALAC:
+        case AV_CODEC_ID_PCM_MULAW:
+        case AV_CODEC_ID_PCM_ALAW:
+            return true;
+        default:
+            return false;
+    }
+}
+
+inline bool LegacyVideo(AVCodecID id) {
+    switch (id) {
+        case AV_CODEC_ID_H264:
+        case AV_CODEC_ID_HEVC:
+        case AV_CODEC_ID_AV1:
+        case AV_CODEC_ID_VP8:
+        case AV_CODEC_ID_VP9:
+        case AV_CODEC_ID_MPEG1VIDEO:
+        case AV_CODEC_ID_MPEG2VIDEO:
+        case AV_CODEC_ID_MPEG4:
+        case AV_CODEC_ID_MSMPEG4V2:
+        case AV_CODEC_ID_MSMPEG4V3:
+        case AV_CODEC_ID_VC1:
+        case AV_CODEC_ID_MJPEG:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Sample rate, channel count, block size, bit rate and bits per coded sample, each used only
+// when it is positive. Returns whether the decoder is one this applies to.
+inline bool ApplyAudio(AVCodecContext *context, int sampleRate, int channels, int blockAlign,
+                       int64_t bitRate, int bitsPerCodedSample) {
+    if (LegacyAudio(context->codec_id)) return false;
+    if (sampleRate > 0) context->sample_rate = sampleRate;
+    if (channels > 0 && channels <= 64) av_channel_layout_default(&context->ch_layout, channels);
+    if (blockAlign > 0) context->block_align = blockAlign;
+    if (bitRate > 0) context->bit_rate = bitRate;
+    if (bitsPerCodedSample > 0 && bitsPerCodedSample <= 64) {
+        context->bits_per_coded_sample = bitsPerCodedSample;
+    }
+    return true;
+}
+
+// The picture's size, bits per coded sample and FourCC (the codec tag: Ut Video reads its pixel
+// format from it), each used only when it is positive and sane (a container's field is outside
+// data, so the size is capped at 16384 on each side).
+inline bool ApplyVideo(AVCodecContext *context, int width, int height, int bitsPerCodedSample,
+                       uint32_t codecTag) {
+    if (LegacyVideo(context->codec_id)) return false;
+    if (codecTag != 0) context->codec_tag = codecTag;
+    if (width > 0 && height > 0 && width <= 16384 && height <= 16384) {
+        context->width = context->coded_width = width;
+        context->height = context->coded_height = height;
+    }
+    if (bitsPerCodedSample > 0 && bitsPerCodedSample <= 64) {
+        context->bits_per_coded_sample = bitsPerCodedSample;
+    }
+    return true;
+}
+
+}  // namespace ffparams
+
+#endif  // TMPLAYER_FFCODECPARAMS_H
--- a/media3ext/src/main/cpp/ffdemux.cpp
+++ b/media3ext/src/main/cpp/ffdemux.cpp
@@ -0,0 +1,266 @@
+// TMPlayer (tm4, C2): the JNI side of ffdemux.h, for the app's com.tmplayer.player.demux.FfmpegDemuxNative.
+// The app's class lives in the app (an app built against nextlib's Maven Central AAR, which lacks
+// these functions, still compiles and only sees UnsatisfiedLinkError, which it reads as "no
+// container reader"). Every call on one handle comes from one thread, the app's demux thread,
+// except nativeProbe, which needs no handle.
+#include <jni.h>
+#include <android/log.h>
+
+#include <cstdint>
+
+#include "ffdemux.h"
+
+#define DEMUX_FUNC(RETURN_TYPE, NAME, ...) \
+  extern "C" JNIEXPORT RETURN_TYPE JNICALL Java_com_tmplayer_player_demux_FfmpegDemuxNative_##NAME(JNIEnv *env, jclass, ##__VA_ARGS__)
+
+namespace {
+
+struct Handle {
+  tmdemux::Demuxer *demuxer = nullptr;
+  JNIEnv *env = nullptr;
+  jobject io = nullptr;
+  jbyteArray buffer = nullptr;
+  jint bufferLength = 0;
+  jmethodID read = nullptr;
+  jmethodID seek = nullptr;
+  tmdemux::Packet packet;
+  bool hasPacket = false;
+};
+
+int ioRead(void *opaque, uint8_t *out, int size) {
+  Handle *h = static_cast<Handle *>(opaque);
+  JNIEnv *env = h->env;
+  jint want = size < h->bufferLength ? size : h->bufferLength;
+  jint n = env->CallIntMethod(h->io, h->read, want);
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    return AVERROR(EIO);
+  }
+  if (n == -1) return AVERROR_EOF;
+  if (n < -1) return AVERROR_EXIT;
+  if (n > want) return AVERROR(EIO);
+  if (n > 0) env->GetByteArrayRegion(h->buffer, 0, n, reinterpret_cast<jbyte *>(out));
+  return n;
+}
+
+int64_t ioSeek(void *opaque, int64_t position) {
+  Handle *h = static_cast<Handle *>(opaque);
+  JNIEnv *env = h->env;
+  jlong at = env->CallLongMethod(h->io, h->seek, (jlong) position);
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    return AVERROR(EIO);
+  }
+  return at < 0 ? AVERROR_EXIT : at;
+}
+
+Handle *handleOf(JNIEnv *env, jlong value) {
+  Handle *h = reinterpret_cast<Handle *>(value);
+  if (h != nullptr) h->env = env;
+  return h;
+}
+
+bool validStream(const Handle *h, jint index) {
+  return h != nullptr && h->demuxer != nullptr && index >= 0 && (unsigned) index < h->demuxer->context->nb_streams;
+}
+
+// Outside text (a language tag) as Java can always take it: printable ASCII only, bounded.
+jstring asciiString(JNIEnv *env, const char *text, size_t limit) {
+  if (text == nullptr) return nullptr;
+  char clean[64];
+  if (limit >= sizeof clean) limit = sizeof clean - 1;
+  size_t n = 0;
+  for (; text[n] != '\0' && n < limit; n++) {
+    char c = text[n];
+    if (c < 0x20 || c > 0x7e) return nullptr;
+    clean[n] = c;
+  }
+  if (n == 0) return nullptr;
+  clean[n] = '\0';
+  return env->NewStringUTF(clean);
+}
+
+}  // namespace
+
+DEMUX_FUNC(jint, nativeApiVersion) { return tmdemux::kApiVersion; }
+
+DEMUX_FUNC(jstring, nativeProbe, jbyteArray data, jint length) {
+  if (data == nullptr || length <= 0) return nullptr;
+  jsize available = env->GetArrayLength(data);
+  if (length > available) length = available;
+  if (length > tmdemux::kProbeBytes) length = tmdemux::kProbeBytes;
+  jbyte *bytes = env->GetByteArrayElements(data, nullptr);
+  if (bytes == nullptr) return nullptr;
+  const char *name = tmdemux::probe(reinterpret_cast<const uint8_t *>(bytes), length);
+  env->ReleaseByteArrayElements(data, bytes, JNI_ABORT);
+  return name == nullptr ? nullptr : env->NewStringUTF(name);
+}
+
+DEMUX_FUNC(jlong, nativeOpen, jstring format, jobject io, jbyteArray buffer, jlong size, jintArray error) {
+  if (format == nullptr || io == nullptr || buffer == nullptr) return 0;
+  jclass ioClass = env->GetObjectClass(io);
+  jmethodID read = env->GetMethodID(ioClass, "read", "(I)I");
+  jmethodID seek = read == nullptr ? nullptr : env->GetMethodID(ioClass, "seek", "(J)J");
+  env->DeleteLocalRef(ioClass);
+  if (read == nullptr || seek == nullptr) {
+    env->ExceptionClear();
+    return 0;
+  }
+  Handle *h = new Handle();
+  h->env = env;
+  h->io = env->NewGlobalRef(io);
+  h->buffer = static_cast<jbyteArray>(env->NewGlobalRef(buffer));
+  h->bufferLength = env->GetArrayLength(buffer);
+  h->read = read;
+  h->seek = seek;
+  tmdemux::Io source;
+  source.opaque = h;
+  source.read = ioRead;
+  source.seek = ioSeek;
+  source.size = size > 0 ? size : -1;
+  const char *name = env->GetStringUTFChars(format, nullptr);
+  int code = 0;
+  h->demuxer = name == nullptr ? nullptr : tmdemux::open(name, source, &code);
+  if (name != nullptr) env->ReleaseStringUTFChars(format, name);
+  if (error != nullptr && env->GetArrayLength(error) > 0) env->SetIntArrayRegion(error, 0, 1, &code);
+  if (h->demuxer == nullptr) {
+    env->DeleteGlobalRef(h->io);
+    env->DeleteGlobalRef(h->buffer);
+    delete h;
+    return 0;
+  }
+  return reinterpret_cast<jlong>(h);
+}
+
+/** [duration in us or -1, stream count, main stream, byte where the packets start, seekable 0/1]. */
+DEMUX_FUNC(jlongArray, nativeInfo, jlong handle) {
+  Handle *h = handleOf(env, handle);
+  if (h == nullptr || h->demuxer == nullptr) return nullptr;
+  jlong values[5] = {
+      tmdemux::durationUs(h->demuxer),
+      (jlong) h->demuxer->context->nb_streams,
+      tmdemux::mainStream(h->demuxer),
+      h->demuxer->dataStart,
+      h->demuxer->avio->seekable ? 1 : 0,
+  };
+  jlongArray out = env->NewLongArray(5);
+  if (out != nullptr) env->SetLongArrayRegion(out, 0, 5, values);
+  return out;
+}
+
+/**
+ * [type (0 video, 1 audio, 2 other), width, height, sample rate, channels, bit rate, block align,
+ * bits per coded sample, codec tag, frame rate numerator, denominator, duration in us or -1,
+ * default 0/1, attached picture 0/1].
+ */
+DEMUX_FUNC(jlongArray, nativeStream, jlong handle, jint index) {
+  Handle *h = handleOf(env, handle);
+  if (!validStream(h, index)) return nullptr;
+  const AVStream *st = h->demuxer->context->streams[index];
+  const AVCodecParameters *p = st->codecpar;
+  AVRational fps = st->avg_frame_rate.num > 0 && st->avg_frame_rate.den > 0 ? st->avg_frame_rate : st->r_frame_rate;
+  int64_t duration = st->duration > 0 ? av_rescale_q(st->duration, st->time_base, AV_TIME_BASE_Q) : -1;
+  jlong values[14] = {
+      p->codec_type == AVMEDIA_TYPE_VIDEO ? 0 : p->codec_type == AVMEDIA_TYPE_AUDIO ? 1 : 2,
+      p->width, p->height, p->sample_rate, p->ch_layout.nb_channels, p->bit_rate, p->block_align,
+      p->bits_per_coded_sample, (jlong) p->codec_tag, fps.num, fps.den, duration,
+      (st->disposition & AV_DISPOSITION_DEFAULT) ? 1 : 0,
+      (st->disposition & AV_DISPOSITION_ATTACHED_PIC) ? 1 : 0,
+  };
+  jlongArray out = env->NewLongArray(14);
+  if (out != nullptr) env->SetLongArrayRegion(out, 0, 14, values);
+  return out;
+}
+
+/**
+ * 0: the name of this build's decoder for the stream (null when there is none), 1: the codec's
+ * name, 2: the language tag, 3: the demuxer's name, 4: the demuxer's long name.
+ */
+DEMUX_FUNC(jstring, nativeText, jlong handle, jint index, jint what) {
+  Handle *h = handleOf(env, handle);
+  if (h == nullptr || h->demuxer == nullptr) return nullptr;
+  const AVFormatContext *c = h->demuxer->context;
+  if (what == 3) return asciiString(env, c->iformat->name, 40);
+  if (what == 4) return asciiString(env, c->iformat->long_name, 60);
+  if (!validStream(h, index)) return nullptr;
+  const AVStream *st = c->streams[index];
+  switch (what) {
+    case 0: {
+      const AVCodec *codec = avcodec_find_decoder(st->codecpar->codec_id);
+      return codec == nullptr ? nullptr : asciiString(env, codec->name, 40);
+    }
+    case 1: return asciiString(env, avcodec_get_name(st->codecpar->codec_id), 40);
+    case 2: {
+      const AVDictionaryEntry *e = av_dict_get(st->metadata, "language", nullptr, 0);
+      return e == nullptr ? nullptr : asciiString(env, e->value, 16);
+    }
+    default: return nullptr;
+  }
+}
+
+DEMUX_FUNC(jbyteArray, nativeExtraData, jlong handle, jint index) {
+  Handle *h = handleOf(env, handle);
+  if (!validStream(h, index)) return nullptr;
+  const AVCodecParameters *p = h->demuxer->context->streams[index]->codecpar;
+  if (p->extradata == nullptr || p->extradata_size <= 0 || p->extradata_size > tmdemux::kMaxExtraData) return nullptr;
+  jbyteArray out = env->NewByteArray(p->extradata_size);
+  if (out != nullptr) env->SetByteArrayRegion(out, 0, p->extradata_size, reinterpret_cast<const jbyte *>(p->extradata));
+  return out;
+}
+
+/** The key frames the demuxer knows of in [stream]: time (us), byte, time, byte... */
+DEMUX_FUNC(jlongArray, nativeIndex, jlong handle, jint stream) {
+  Handle *h = handleOf(env, handle);
+  if (!validStream(h, stream)) return nullptr;
+  int count = avformat_index_get_entries_count(h->demuxer->context->streams[stream]);
+  if (count <= 0) return env->NewLongArray(0);
+  int capacity = count < tmdemux::kMaxIndexEntries ? count : tmdemux::kMaxIndexEntries;
+  int64_t *pairs = new int64_t[2 * (size_t) capacity];
+  int written = tmdemux::index(h->demuxer, stream, pairs, capacity);
+  jlongArray out = env->NewLongArray(2 * written);
+  if (out != nullptr && written > 0) env->SetLongArrayRegion(out, 0, 2 * written, reinterpret_cast<const jlong *>(pairs));
+  delete[] pairs;
+  return out;
+}
+
+/**
+ * Reads the next packet: its size, with [meta] = [stream, time in us or Long.MIN_VALUE, duration
+ * in us, key 0/1, byte position], or below 0 (-1 the end, another value an error). Its bytes are
+ * fetched with nativeCopy.
+ */
+DEMUX_FUNC(jint, nativeRead, jlong handle, jlongArray meta) {
+  Handle *h = handleOf(env, handle);
+  if (h == nullptr || h->demuxer == nullptr || meta == nullptr || env->GetArrayLength(meta) < 5) return -2;
+  h->hasPacket = false;
+  int ret = tmdemux::read(h->demuxer, &h->packet);
+  if (ret == AVERROR_EOF) return -1;
+  if (ret < 0) return ret == -1 ? -2 : ret;
+  h->hasPacket = true;
+  jlong values[5] = {h->packet.stream, h->packet.timeUs, h->packet.durationUs, h->packet.key ? 1 : 0, h->packet.position};
+  env->SetLongArrayRegion(meta, 0, 5, values);
+  return h->packet.size;
+}
+
+DEMUX_FUNC(jint, nativeCopy, jlong handle, jbyteArray out) {
+  Handle *h = handleOf(env, handle);
+  if (h == nullptr || !h->hasPacket || out == nullptr) return -1;
+  if (env->GetArrayLength(out) < h->packet.size) return -1;
+  if (h->packet.size > 0) env->SetByteArrayRegion(out, 0, h->packet.size, reinterpret_cast<const jbyte *>(h->packet.data));
+  return h->packet.size;
+}
+
+DEMUX_FUNC(jint, nativeSeek, jlong handle, jlong timeUs, jlong bytePosition) {
+  Handle *h = handleOf(env, handle);
+  if (h == nullptr || h->demuxer == nullptr) return -1;
+  h->hasPacket = false;
+  return tmdemux::seek(h->demuxer, timeUs, bytePosition);
+}
+
+DEMUX_FUNC(void, nativeClose, jlong handle) {
+  Handle *h = handleOf(env, handle);
+  if (h == nullptr) return;
+  tmdemux::close(h->demuxer);
+  env->DeleteGlobalRef(h->io);
+  env->DeleteGlobalRef(h->buffer);
+  delete h;
+}
