+// TMPlayer (HX2c): the light video mode, asked for per format by the app (FfmpegLibrary's
+// setLightVideoPolicy) for pictures the device cannot decode in software in real time.
+// kFlagLight: AV1 with dav1d's frame threads instead of LOW_DELAY, film grain exported rather
+// than applied (any codec), and 4:2:0 frames reduced to 8 bits without swscale. kFlagYv12: the
+// window takes YV12, so no RGBA conversion at all; off on emulators, whose graphics backend
+// shows YV12 CPU buffers wrongly. Without the flags everything runs as before.
+constexpr int kFlagLight = 1;
+constexpr int kFlagYv12 = 2;
+// dav1d's frame contexts in the light mode: 2 is what dav1d picks by itself for 4 threads
+// (ceil(sqrt(threads))), and the frames a seek or the end of a file waits for. On the host bench
+// (scripts/media3ext/bench in TMPlayer) 3 decoded about 30% faster again for about 23 MB more at
+// 1080p 10-bit, so a device can try it without a rebuild:
+// `adb shell setprop debug.tmplayer.av1_frame_delay 3` (1 to 8; read at each decoder's start).
+constexpr int kLightAv1FrameDelay = 2;
+
+static int LightAv1FrameDelay() {
+    char value[PROP_VALUE_MAX] = {};
+    if (__system_property_get("debug.tmplayer.av1_frame_delay", value) > 0) {
+        const int delay = atoi(value);
+        if (delay >= 1 && delay <= 8) return delay;
+    }
+    return kLightAv1FrameDelay;
