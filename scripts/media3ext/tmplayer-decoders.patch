+// TMPlayer (tm3): what a container tells a decoder before the first packet, for the decoders
+// TMPlayer's patch adds. Kept apart, and free of JNI, so the host test (TMPlayer's
+// scripts/media3ext/bench, "codec" mode) runs the very code the app runs.
+//
+// Nextlib's own decoders (H.264, HEVC, AAC, AC-3, ...) work from their in-band headers and from the
+// extra data alone, and are left exactly as they were: Legacy*() names them. The old and the
+// exotic formats added in tm3 mostly cannot: a WMA or ADPCM stream has its sample rate, channel
+// count and block size only in the container, and a Cinepak, RealVideo or WMV picture its size.
+#ifndef TMPLAYER_FFCODECPARAMS_H
+#define TMPLAYER_FFCODECPARAMS_H
+
+#include <cstdint>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/channel_layout.h>
+}
+
+namespace ffparams {
+
+// Decoders nextlib and TMPlayer's earlier revisions (tm1, tm2) already ran: untouched.
+inline bool LegacyAudio(AVCodecID id) {
+    switch (id) {
+        case AV_CODEC_ID_AAC:
+        case AV_CODEC_ID_MP3:
+        case AV_CODEC_ID_AC3:
+        case AV_CODEC_ID_EAC3:
+        case AV_CODEC_ID_TRUEHD:
+        case AV_CODEC_ID_MLP:
+        case AV_CODEC_ID_DTS:
+        case AV_CODEC_ID_VORBIS:
+        case AV_CODEC_ID_OPUS:
+        case AV_CODEC_ID_AMR_NB:
+        case AV_CODEC_ID_AMR_WB:
+        case AV_CODEC_ID_FLAC:
+        case AV_CODEC_ID_ALAC:
+        case AV_CODEC_ID_PCM_MULAW:
+        case AV_CODEC_ID_PCM_ALAW:
+            return true;
+        default:
+            return false;
+    }
+}
+
+inline bool LegacyVideo(AVCodecID id) {
+    switch (id) {
+        case AV_CODEC_ID_H264:
+        case AV_CODEC_ID_HEVC:
+        case AV_CODEC_ID_AV1:
+        case AV_CODEC_ID_VP8:
+        case AV_CODEC_ID_VP9:
+        case AV_CODEC_ID_MPEG1VIDEO:
+        case AV_CODEC_ID_MPEG2VIDEO:
+        case AV_CODEC_ID_MPEG4:
+        case AV_CODEC_ID_MSMPEG4V2:
+        case AV_CODEC_ID_MSMPEG4V3:
+        case AV_CODEC_ID_VC1:
+        case AV_CODEC_ID_MJPEG:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Sample rate, channel count, block size, bit rate and bits per coded sample, each used only
+// when it is positive. Returns whether the decoder is one this applies to.
+inline bool ApplyAudio(AVCodecContext *context, int sampleRate, int channels, int blockAlign,
+                       int64_t bitRate, int bitsPerCodedSample) {
+    if (LegacyAudio(context->codec_id)) return false;
+    if (sampleRate > 0) context->sample_rate = sampleRate;
+    if (channels > 0 && channels <= 64) av_channel_layout_default(&context->ch_layout, channels);
+    if (blockAlign > 0) context->block_align = blockAlign;
+    if (bitRate > 0) context->bit_rate = bitRate;
+    if (bitsPerCodedSample > 0 && bitsPerCodedSample <= 64) {
+        context->bits_per_coded_sample = bitsPerCodedSample;
+    }
+    return true;
+}
+
+// The picture's size and bits per coded sample, each used only when it is positive and sane (a
+// container's field is outside data, so the size is capped at 16384 on each side).
+inline bool ApplyVideo(AVCodecContext *context, int width, int height, int bitsPerCodedSample) {
+    if (LegacyVideo(context->codec_id)) return false;
+    if (width > 0 && height > 0 && width <= 16384 && height <= 16384) {
+        context->width = context->coded_width = width;
+        context->height = context->coded_height = height;
+    }
+    if (bitsPerCodedSample > 0 && bitsPerCodedSample <= 64) {
+        context->bits_per_coded_sample = bitsPerCodedSample;
+    }
+    return true;
+}
+
+}  // namespace ffparams
+
+#endif  // TMPLAYER_FFCODECPARAMS_H
