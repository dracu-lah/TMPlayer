+++ b/media3ext/src/main/cpp/ffdemux.h
@@ -0,0 +1,407 @@
+// TMPlayer (tm4, C2): FFmpeg's libavformat as the last-resort container reader of the app's Media3
+// extractor (com.tmplayer.player.demux.FfmpegExtractor), for the containers Media3 has no extractor
+// for: ASF/WMV/WMA, RealMedia, MPEG-1 system streams, Ogg with Theora, NUT, MXF, DV and others (the
+// list below; ffmpeg/setup.sh compiles these demuxers and no other).
+//
+// Pure C++ over libavformat with no JNI, so scripts/media3ext/bench/demuxtest.cpp runs the same code
+// on the host. The bytes come from two callbacks, read and seek, that the app answers from Media3's
+// ExtractorInput (which a seek reopens at the new byte, moving TDLib's download there): libavformat
+// reads only what the demuxer asks for and never opens anything by itself (no protocol is compiled
+// and io_open refuses).
+//
+// Outside data: every size, count and index is bounded here, and a file the demuxer refuses is an
+// error, never a crash of this code.
+#ifndef TMPLAYER_FFDEMUX_H
+#define TMPLAYER_FFDEMUX_H
+
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/avutil.h>
+#include <libavutil/mathematics.h>
+}
+
+namespace tmdemux {
+
+/** The version of this interface, so the app can tell an AAR without it, or an older one. */
+constexpr int kApiVersion = 1;
+
+constexpr int kAvioBufferSize = 64 * 1024;
+/** What libavformat may read to find the streams: 1 MB and 2 s of picture, enough for every header. */
+constexpr int64_t kProbeSize = 1 << 20;
+constexpr int64_t kMaxAnalyzeDuration = 2 * AV_TIME_BASE;
+constexpr int kMaxStreams = 32;
+constexpr int kMaxExtraData = 1 << 20;
+constexpr int kMaxPacket = 32 << 20;
+constexpr int kMaxIndexEntries = 1 << 16;
+/** What fillMpegSequenceHeader reads to find the first sequence header of a stream. */
+constexpr int kMaxHeaderScanPackets = 256;
+constexpr int64_t kMaxHeaderScanBytes = 4 << 20;
+/** The bytes the sniff hands probe(). */
+constexpr int kProbeBytes = 32 * 1024;
+/** A probe score below this is a guess (libavformat's own retry threshold). */
+constexpr int kMinProbeScore = AVPROBE_SCORE_MAX / 4;
+
+/**
+ * The demuxers this reader uses, by libavformat's runtime name (MPEG-PS is "mpeg"). Every other
+ * container is Media3's, whose extractors run first.
+ */
+static const char *const kDemuxers[] = {
+    "asf", "rm", "ivr", "xwma", "dv", "nut", "mxf", "nsv", "wtv", "ape", "tta", "wv",
+    "aiff", "au", "caf", "voc", "w64", "ogg", "mpeg", "smjpeg", "vivo",
+};
+
+inline bool allowedDemuxer(const char *name) {
+  if (name == nullptr) return false;
+  for (const char *allowed : kDemuxers) {
+    if (strcmp(allowed, name) == 0) return true;
+  }
+  return false;
+}
+
+/**
+ * The name of the demuxer (one of kDemuxers) that recognises [data], or nullptr. [size] may be
+ * anything; only the first kProbeBytes are looked at.
+ */
+inline const char *probe(const uint8_t *data, int size) {
+  if (data == nullptr || size <= 0) return nullptr;
+  if (size > kProbeBytes) size = kProbeBytes;
+  // libavformat's probes read up to AVPROBE_PADDING_SIZE past the end, which must be zeros.
+  uint8_t *padded = static_cast<uint8_t *>(av_mallocz(size + AVPROBE_PADDING_SIZE));
+  if (padded == nullptr) return nullptr;
+  memcpy(padded, data, size);
+  AVProbeData pd = {};
+  pd.filename = "";
+  pd.buf = padded;
+  pd.buf_size = size;
+  int score = 0;
+  const AVInputFormat *format = av_probe_input_format3(&pd, 1, &score);
+  av_free(padded);
+  if (format == nullptr || score < kMinProbeScore || !allowedDemuxer(format->name)) return nullptr;
+  return format->name;
+}
+
+/** Where the bytes come from. read: bytes read, 0 or AVERROR_EOF at the end, below 0 an error. */
+struct Io {
+  void *opaque = nullptr;
+  int (*read)(void *opaque, uint8_t *buffer, int size) = nullptr;
+  /** Moves to [position] and returns it, or below 0. */
+  int64_t (*seek)(void *opaque, int64_t position) = nullptr;
+  /** The file's size, or -1 when unknown (no seeking then). */
+  int64_t size = -1;
+};
+
+struct Packet {
+  int stream = -1;
+  /** Presentation time (or decode time where there is none) in microseconds from the start, or INT64_MIN. */
+  int64_t timeUs = INT64_MIN;
+  int64_t durationUs = 0;
+  bool key = false;
+  int64_t position = -1;
+  const uint8_t *data = nullptr;
+  int size = 0;
+};
+
+struct Demuxer {
+  AVFormatContext *context = nullptr;
+  AVIOContext *avio = nullptr;
+  AVPacket *packet = nullptr;
+  Io io;
+  int64_t position = 0;
+  int64_t startUs = 0;
+  int64_t dataStart = 0;
+  bool aborted = false;
+};
+
+namespace detail {
+
+inline int readCallback(void *opaque, uint8_t *buffer, int size) {
+  Demuxer *d = static_cast<Demuxer *>(opaque);
+  if (d->aborted) return AVERROR_EXIT;
+  if (size <= 0) return 0;
+  int n = d->io.read(d->io.opaque, buffer, size);
+  if (n == 0 || n == AVERROR_EOF) return AVERROR_EOF;
+  if (n < 0) return n;
+  if (n > size) return AVERROR(EIO);
+  d->position += n;
+  return n;
+}
+
+inline int64_t seekCallback(void *opaque, int64_t offset, int whence) {
+  Demuxer *d = static_cast<Demuxer *>(opaque);
+  if (d->aborted) return AVERROR_EXIT;
+  whence &= ~AVSEEK_FORCE;
+  if (whence == AVSEEK_SIZE) return d->io.size >= 0 ? d->io.size : AVERROR(ENOSYS);
+  int64_t target;
+  switch (whence) {
+    case SEEK_SET: target = offset; break;
+    case SEEK_CUR: target = d->position + offset; break;
+    case SEEK_END:
+      if (d->io.size < 0) return AVERROR(ENOSYS);
+      target = d->io.size + offset;
+      break;
+    default: return AVERROR(EINVAL);
+  }
+  if (target < 0 || (d->io.size >= 0 && target > d->io.size)) return AVERROR(EINVAL);
+  int64_t at = d->io.seek(d->io.opaque, target);
+  if (at < 0) return at;
+  d->position = at;
+  return at;
+}
+
+/** No nested opens: a playlist, a reference or an image sequence never reaches the disk or the net. */
+inline int refuseOpen(AVFormatContext *, AVIOContext **, const char *, int, AVDictionary **) {
+  return AVERROR(EPERM);
+}
+
+}  // namespace detail
+
+inline void close(Demuxer *d) {
+  if (d == nullptr) return;
+  if (d->context != nullptr) avformat_close_input(&d->context);
+  if (d->avio != nullptr) {
+    av_freep(&d->avio->buffer);
+    avio_context_free(&d->avio);
+  }
+  if (d->packet != nullptr) av_packet_free(&d->packet);
+  delete d;
+}
+
+/** The stream seeks and the SeekMap go by: the first picture, else the first sound. */
+inline int mainStream(const Demuxer *d) {
+  int audio = -1;
+  for (unsigned i = 0; i < d->context->nb_streams; i++) {
+    const AVCodecParameters *p = d->context->streams[i]->codecpar;
+    if (p->codec_type == AVMEDIA_TYPE_VIDEO && !(d->context->streams[i]->disposition & AV_DISPOSITION_ATTACHED_PIC)) return (int) i;
+    if (p->codec_type == AVMEDIA_TYPE_AUDIO && audio < 0) audio = (int) i;
+  }
+  return audio;
+}
+
+/**
+ * An MPEG-1 or MPEG-2 video stream in a program stream has no extra data: the sequence header
+ * (00 00 01 B3, with the extension and user data that follow it) sits once in the first video
+ * packet, and a decoder started after a seek never sees it. Copies it from there into the stream's
+ * extra data, which the app hands the decoder, then goes back to where the data starts. Reads at
+ * most kMaxHeaderScanPackets packets and kMaxHeaderScanBytes bytes, and keeps nothing on failure.
+ */
+inline void fillMpegSequenceHeader(Demuxer *d) {
+  const AVStream *wanted[kMaxStreams] = {};
+  int missing = 0;
+  for (unsigned i = 0; i < d->context->nb_streams && i < (unsigned) kMaxStreams; i++) {
+    const AVStream *st = d->context->streams[i];
+    const AVCodecParameters *p = st->codecpar;
+    if (p->codec_type == AVMEDIA_TYPE_VIDEO && p->extradata_size == 0 &&
+        (p->codec_id == AV_CODEC_ID_MPEG1VIDEO || p->codec_id == AV_CODEC_ID_MPEG2VIDEO)) {
+      wanted[i] = st;
+      missing++;
+    }
+  }
+  if (missing == 0 || !d->avio->seekable) return;
+  int64_t scanned = 0;
+  for (int n = 0; n < kMaxHeaderScanPackets && missing > 0 && scanned < kMaxHeaderScanBytes; n++) {
+    int ret = av_read_frame(d->context, d->packet);
+    if (ret < 0) break;
+    const AVPacket *pk = d->packet;
+    scanned += pk->size;
+    if (pk->stream_index >= 0 && pk->stream_index < kMaxStreams && wanted[pk->stream_index] != nullptr &&
+        pk->data != nullptr && pk->size > 4) {
+      const uint8_t *data = pk->data;
+      int size = pk->size;
+      int from = -1;
+      for (int i = 0; i + 4 <= size; i++) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 && data[i + 3] == 0xB3) {
+          from = i;
+          break;
+        }
+      }
+      if (from >= 0) {
+        // Up to the group of pictures (B8) or the first picture (00), the end of the header block.
+        int to = size;
+        for (int i = from + 4; i + 4 <= size; i++) {
+          if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 && (data[i + 3] == 0xB8 || data[i + 3] == 0x00)) {
+            to = i;
+            break;
+          }
+        }
+        int length = to - from;
+        AVCodecParameters *par = d->context->streams[pk->stream_index]->codecpar;
+        if (length >= 12 && length <= kMaxExtraData) {
+          uint8_t *copy = static_cast<uint8_t *>(av_mallocz(length + AV_INPUT_BUFFER_PADDING_SIZE));
+          if (copy != nullptr) {
+            memcpy(copy, data + from, length);
+            par->extradata = copy;
+            par->extradata_size = length;
+          }
+        }
+        // The first packet is the only place the header is: this stream is done, found or not.
+        wanted[pk->stream_index] = nullptr;
+        missing--;
+      }
+    }
+    av_packet_unref(d->packet);
+  }
+  av_packet_unref(d->packet);
+  // Back to the first packet (a byte seek, which the mpeg demuxer does without an index).
+  d->avio->error = 0;
+  d->avio->eof_reached = 0;
+  av_seek_frame(d->context, -1, d->dataStart, AVSEEK_FLAG_BYTE);
+}
+
+/**
+ * Opens [format] (one of kDemuxers) over [io] and reads its streams. Returns nullptr on any
+ * failure, with [error] set to libavformat's code where there is one.
+ */
+inline Demuxer *open(const char *format, const Io &io, int *error) {
+  *error = 0;
+  if (!allowedDemuxer(format) || io.read == nullptr || io.seek == nullptr) {
+    *error = AVERROR(EINVAL);
+    return nullptr;
+  }
+  const AVInputFormat *input = av_find_input_format(format);
+  if (input == nullptr) {
+    *error = AVERROR_DEMUXER_NOT_FOUND;
+    return nullptr;
+  }
+  Demuxer *d = new Demuxer();
+  d->io = io;
+  d->packet = av_packet_alloc();
+  uint8_t *buffer = static_cast<uint8_t *>(av_malloc(kAvioBufferSize));
+  if (d->packet == nullptr || buffer == nullptr) {
+    av_free(buffer);
+    close(d);
+    *error = AVERROR(ENOMEM);
+    return nullptr;
+  }
+  d->avio = avio_alloc_context(buffer, kAvioBufferSize, 0, d, detail::readCallback, nullptr, detail::seekCallback);
+  if (d->avio == nullptr) {
+    av_free(buffer);
+    close(d);
+    *error = AVERROR(ENOMEM);
+    return nullptr;
+  }
+  d->avio->seekable = io.size > 0 ? AVIO_SEEKABLE_NORMAL : 0;
+  // A jump of up to 32 KB past the buffer is read through by libavformat itself; any other is
+  // the seek callback's, which the app answers by reading on (up to 256 KB) or by reopening there.
+  AVFormatContext *context = avformat_alloc_context();
+  if (context == nullptr) {
+    close(d);
+    *error = AVERROR(ENOMEM);
+    return nullptr;
+  }
+  context->pb = d->avio;
+  context->flags |= AVFMT_FLAG_CUSTOM_IO | AVFMT_FLAG_DISCARD_CORRUPT;
+  context->probesize = kProbeSize;
+  context->max_analyze_duration = kMaxAnalyzeDuration;
+  context->max_streams = kMaxStreams;
+  context->io_open = detail::refuseOpen;
+  int ret = avformat_open_input(&context, "", input, nullptr);
+  if (ret < 0) {
+    // avformat_open_input frees the context on failure, never the custom AVIO.
+    close(d);
+    *error = ret;
+    return nullptr;
+  }
+  d->context = context;
+  d->dataStart = avio_tell(d->avio);
+  // The streams a header leaves out (MPEG-PS has none), and the picture size and sample rate of
+  // the rest. A failure here keeps what the header gave.
+  avformat_find_stream_info(context, nullptr);
+  if (context->nb_streams == 0 || mainStream(d) < 0) {
+    close(d);
+    *error = AVERROR_INVALIDDATA;
+    return nullptr;
+  }
+  d->startUs = context->start_time != AV_NOPTS_VALUE && context->start_time > 0 ? context->start_time : 0;
+  fillMpegSequenceHeader(d);
+  // ASF keeps its index at the end, read only by its first seek: one tail read now (like an MP4
+  // with its index at the end), so the SeekMap has the index from the start. Seeking to the start
+  // also takes the reader back to the first packet, which the stream search went past.
+  if (strcmp(format, "asf") == 0 && d->avio->seekable) {
+    av_seek_frame(context, -1, context->start_time != AV_NOPTS_VALUE ? context->start_time : 0, AVSEEK_FLAG_BACKWARD);
+  }
+  return d;
+}
+
+/** Reads the next packet into [out]; 0, AVERROR_EOF at the end, or another error. */
+inline int read(Demuxer *d, Packet *out) {
+  av_packet_unref(d->packet);
+  for (int skipped = 0; skipped < 1024; skipped++) {
+    int ret = av_read_frame(d->context, d->packet);
+    if (ret < 0) return ret;
+    const AVPacket *p = d->packet;
+    if (p->stream_index < 0 || (unsigned) p->stream_index >= d->context->nb_streams ||
+        p->size < 0 || p->size > kMaxPacket || (p->size > 0 && p->data == nullptr)) {
+      av_packet_unref(d->packet);
+      continue;
+    }
+    const AVStream *st = d->context->streams[p->stream_index];
+    int64_t ts = p->pts != AV_NOPTS_VALUE ? p->pts : p->dts;
+    out->stream = p->stream_index;
+    out->timeUs = ts == AV_NOPTS_VALUE ? INT64_MIN : av_rescale_q(ts, st->time_base, AV_TIME_BASE_Q) - d->startUs;
+    out->durationUs = p->duration > 0 ? av_rescale_q(p->duration, st->time_base, AV_TIME_BASE_Q) : 0;
+    out->key = (p->flags & AV_PKT_FLAG_KEY) != 0;
+    out->position = p->pos;
+    out->data = p->data;
+    out->size = p->size;
+    return 0;
+  }
+  return AVERROR_INVALIDDATA;
+}
+
+/**
+ * Seeks to the last key frame at or before [timeUs] (from the start); [bytePosition], when not
+ * negative, is where to go on if the demuxer cannot seek by time. 0 or an error.
+ */
+inline int seek(Demuxer *d, int64_t timeUs, int64_t bytePosition) {
+  // A read the app cut short (a seek arrived while it waited) leaves the AVIO marked failed.
+  d->avio->error = 0;
+  d->avio->eof_reached = 0;
+  int64_t target = timeUs + d->startUs;
+  if (target < 0) target = 0;
+  int ret = av_seek_frame(d->context, -1, target, AVSEEK_FLAG_BACKWARD);
+  if (ret < 0) ret = avformat_seek_file(d->context, -1, INT64_MIN, target, target, 0);
+  if (ret < 0 && bytePosition >= 0) {
+    d->avio->error = 0;
+    d->avio->eof_reached = 0;
+    ret = av_seek_frame(d->context, -1, bytePosition, AVSEEK_FLAG_BYTE);
+  }
+  return ret;
+}
+
+/**
+ * The key frames the demuxer knows of in [stream], as time (microseconds from the start) and byte
+ * pairs into [out] (room for [capacity] pairs). Returns the number of pairs written.
+ */
+inline int index(const Demuxer *d, int stream, int64_t *out, int capacity) {
+  if (stream < 0 || (unsigned) stream >= d->context->nb_streams || capacity <= 0) return 0;
+  AVStream *st = d->context->streams[stream];
+  int count = avformat_index_get_entries_count(st);
+  if (count <= 0) return 0;
+  // Every entry, or an even spread over a huge index.
+  int step = count > capacity ? (count + capacity - 1) / capacity : 1;
+  int written = 0;
+  int64_t lastTime = INT64_MIN;
+  for (int i = 0; i < count && written < capacity; i += step) {
+    const AVIndexEntry *e = avformat_index_get_entry(st, i);
+    if (e == nullptr || !(e->flags & AVINDEX_KEYFRAME) || e->pos < 0 || e->timestamp == AV_NOPTS_VALUE) continue;
+    int64_t t = av_rescale_q(e->timestamp, st->time_base, AV_TIME_BASE_Q) - d->startUs;
+    if (t <= lastTime) continue;
+    lastTime = t;
+    out[2 * written] = t;
+    out[2 * written + 1] = e->pos;
+    written++;
+  }
+  return written;
+}
+
+inline int64_t durationUs(const Demuxer *d) {
+  return d->context->duration > 0 ? d->context->duration : -1;
+}
+
+}  // namespace tmdemux
+
+#endif  // TMPLAYER_FFDEMUX_H
--- a/media3ext/src/main/cpp/fflight.h
+++ b/media3ext/src/main/cpp/fflight.h
@@ -0,0 +1,70 @@
+// TMPlayer (HX2c): the frame step of the light video mode, kept apart so the host benchmark
+// (TMPlayer's scripts/media3ext/bench) times the very code the app runs.
+//
+// A 4:2:0 frame of 8 or 10 bits in limited range goes to three 8-bit planes by a plain copy or a
+// rounded shift, with no colour conversion: the window (YV12) or Media3's YUV renderer turns it
+// into RGB on the GPU. Everything else still goes through swscale.
+#ifndef TMPLAYER_FFLIGHT_H
+#define TMPLAYER_FFLIGHT_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+#include <libavutil/frame.h>
+#include <libavutil/pixfmt.h>
+}
+
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+#include <arm_neon.h>
+#endif
+
+namespace fflight {
+
+// 10-bit samples to 8-bit, rounded to nearest and saturated (1023 gives 255).
+inline void Reduce10To8(const uint16_t *__restrict src, uint8_t *__restrict dst, int count) {
+    int i = 0;
