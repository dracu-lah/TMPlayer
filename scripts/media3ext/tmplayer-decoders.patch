+// TMPlayer (HX2c): the frame step of the light video mode, kept apart so the host benchmark
+// (TMPlayer's scripts/media3ext/bench) times the very code the app runs.
+//
+// A 4:2:0 frame of 8 or 10 bits in limited range goes to three 8-bit planes by a plain copy or a
+// rounded shift, with no colour conversion: the window (YV12) or Media3's YUV renderer turns it
+// into RGB on the GPU. Everything else still goes through swscale.
+#ifndef TMPLAYER_FFLIGHT_H
+#define TMPLAYER_FFLIGHT_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+#include <libavutil/frame.h>
+#include <libavutil/pixfmt.h>
+}
