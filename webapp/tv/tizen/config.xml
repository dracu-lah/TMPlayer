<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://tmplayer.org/tv" version="{{VERSION}}" viewmodes="maximized">
  <tizen:application id="TMPlayerTV.TMPlayer" package="TMPlayerTV" required_version="5.5"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>TMPlayer</name>
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>{{HOST}}</tizen:allow-navigation>
  <tizen:content-security-policy>default-src 'self' {{ORIGIN}} data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' {{ORIGIN}} ws: wss:; media-src 'self' {{ORIGIN}} blob: data:; img-src 'self' {{ORIGIN}} data: blob:</tizen:content-security-policy>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
