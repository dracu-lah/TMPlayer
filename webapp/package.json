{
  "name": "tmplayer-webapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "rules": "cd .. && ./gradlew -q :core:webRules",
    "dev": "vite",
    "build": "pnpm rules && tsc --noEmit && vite build",
    "preview": "vite preview --port 8091",
    "check": "tsc --noEmit",
    "test:tmdb": "node --test \"tmdb/*.test.ts\"",
    "test:player": "node --test \"src/player/*.test.ts\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@mediabunny/aac-encoder": "1.62.1",
    "@mediabunny/ac3": "1.62.1",
    "@mediabunny/dts": "1.62.1",
    "@mtcute/web": "0.32.6",
    "@solid-primitives/i18n": "2.2.1",
    "@solidjs/router": "1.0.0",
    "@tanstack/solid-virtual": "3.13.49",
    "@videojs/html": "10.2.0",
    "ass-compiler": "0.1.16",
    "idb-keyval": "6.3.0",
    "mediabunny": "1.62.1",
    "solid-js": "1.9.17",
    "uqr": "0.1.3",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.0",
    "rollup-plugin-license": "3.7.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
