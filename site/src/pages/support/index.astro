---
// /support/: English only. Every way to help, all of it voluntary; nothing in the app is locked
// behind any of it.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumb } from '../../components/breadcrumb';
import HeaderPlain from '../../components/plain/HeaderPlain.astro';
import FooterPlain from '../../components/plain/FooterPlain.astro';
import CoffeeButton from '../../components/CoffeeButton.astro';
import { SPONSORS_URL } from '../../lib/support';
import ShareLinks from '../../components/support/ShareLinks.astro';
import { ENGLISH } from '../../i18n/langs';

Astro.locals.lang = ENGLISH;

---
<Base path="/support/" title="Support TMPlayer: sponsor, star or share it" description="Ways to support TMPlayer: sponsor it, buy a coffee, star it on GitHub or tell a friend. All voluntary, and nothing is locked behind it.">
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Support', '/support/'])} />
  </Fragment>

<HeaderPlain />

<main id="main" class="policy-page">
  <div class="wrap policy-wrap">
    <p class="eyebrow">Support the project</p>
    <h1>Support TMPlayer</h1>
    <p class="policy-lede">TMPlayer is free and open source: no ads, no paid tier, no account of ours. Everything here is voluntary and unlocks nothing.</p>

    <section id="chip-in">
      <h2>Chip in</h2>
      <p>If TMPlayer saves you some bother, a coffee or a monthly sponsorship pays for the time that goes into it. Any amount is welcome, and one coffee is plenty.</p>
      <div class="support-coffee support-coffee-start">
        <CoffeeButton label="Buy me a coffee" large />
        <a class="support-alt" href={SPONSORS_URL} rel="noopener"><Icon name="heart-btn" /> Sponsor on GitHub</a>
      </div>
    </section>

    <section id="star">
      <h2>Star it on GitHub</h2>
      <p>A star costs nothing and takes one click. It is how the next person, reading a GitHub page cold, learns that somebody else already trusted this app.</p>
      <div class="support-coffee support-coffee-start">
        <a class="btn btn-filled" href="https://github.com/dracu-lah/TMPlayer" rel="noopener">
          <Icon name="star-btn" />
          Star on GitHub
        </a>
      </div>
    </section>

    <section id="share">
      <h2>Tell a friend</h2>
      <p>Know someone who watches Telegram videos on a TV or a computer? Send them <a href="https://tmplayer.org/">tmplayer.org</a>.</p>
      <ShareLinks />
    </section>

    <section>
      <h2>Already supporting?</h2>
      <p>Thank you. Nothing more to do here: the app will not ask again once you tell it, in Settings or on the card that asks.</p>
    </section>
  </div>
</main>

<FooterPlain />
</Base>
