---
// /translate/ in every published language: who translates, how to fix a word, and the rules.
// The links to tree/main/site/i18n must keep working, so the catalogs stay in site/i18n/.
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import Step from '../../../components/Step.astro';
import Steps from '../../../components/Steps.astro';
import LangList from '../../../components/translate/LangList.astro';
import Card from '../../../components/Card.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);


const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Help translate TMPlayer",
  "description": "TMPlayer speaks 22 languages, on the website and in the app, machine translated first and corrected by the people who use them. Here is how to fix a word or add a language.",
  "url": "https://tmplayer.org/translate/",
  "inLanguage": "en"
};
---
<Base page="translate" title={t('translate.help_translate_tmplayer_tmplayer')} socialTitle={t('translate.help_translate_tmplayer')} description={t('translate.tmplayer_speaks_21_languages_on')} ogType="article">
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Translate', '/translate/'])} />
    <JsonLd data={webPage} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="translate" />

<main id="main">

  <PageHead lede={t('translate.besides_english_tmplayer_comes_in')}>
    <Fragment slot="crumbs"><T k="translate.translate"><a href={l('/')} slot="a1">{t('translate.translate__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></Fragment>
    <Fragment slot="title"><T k="translate.help_tmplayer"><em slot="em1">{t('translate.help_tmplayer__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href="#fix">{t('translate.fix_a_translation')} <Icon name="arrow-right-sm" /></a>
      <a class="btn btn-outline" href="https://github.com/dracu-lah/TMPlayer/tree/main/site/i18n">{t('translate.the_files_on_github')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
  </PageHead>
  <Band wave id="languages" title={t('translate.twenty_languages_and_english')} sub={t('translate.a_language_you_can_read')} tonal body>
    <div class="panel">
      <LangList />
    </div>
  </Band>
  <StarBand lede={t('features.every_feature_here_started_as')} />

  <Band id="fix" title={t('translate.fix_a_word')} sub={t('translate.three_ways_from_the_quickest')} body>
    <Steps>
      <Step id="fix-1" title={t('translate.tell_us')}>
        <p><T k="translate.say_which_page_or_screen"><a href="https://t.me/tmplayer_chat" rel="noopener" slot="a1">{t('translate.say_which_page_or_screen__a1')}</a><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a2">{t('translate.say_which_page_or_screen__a2')}</a></T></p>
      </Step>
      <Step id="fix-2" title={t('translate.edit_the_file_yourself')}>
        <p><T k="translate.every_language_is_one_json"><a href="https://github.com/dracu-lah/TMPlayer/tree/main/site/i18n" rel="noopener" slot="a1"><code>site/i18n/</code></a><code slot="code1">core/src/commonMain/resources/i18n/</code><code slot="code2">es-419.json</code></T></p>
        <p><T k="translate.english_is_the_source_is"><code slot="code1">en.json</code></T></p>
      </Step>
      <Step id="fix-3" title={t('translate.review_a_whole_language')}>
        <p>{t('translate.read_the_site_or_the')}</p>
      </Step>
    </Steps>
  </Band>
  <Band wave id="rules" title={t('translate.a_few_rules')} tonal>
    <Cards>
      <Card title={t('translate.keep_the_braces')}><T k="translate.words_in_curly_braces_such"><code slot="code1">{'{'}version{'}'}</code><code slot="code2">{'{'}a1{'}'}</code></T></Card>
      <Card title={t('translate.keep_the_names')}>{t('translate.tmplayer_telegram_android_tv_fire')}</Card>
      <Card title={t('translate.short_beats_literal')}>{t('translate.a_button_that_fits_is')}</Card>
    </Cards>
  </Band>
  <Band wave id="new" title={t('translate.a_new_language')}>
    <p class="muted small section-note" data-reveal><T k="translate.naming_the_language_and_saying"><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a1">{t('translate.naming_the_language_and_saying__a1')}</a></T></p>

    <DownloadCard />
  </Band>

  <GiveBand wave tonal />

</main>

<ToTop />

<Footer />
</Base>
