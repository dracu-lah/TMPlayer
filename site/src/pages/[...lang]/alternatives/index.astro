---
// /alternatives/ in every published language: the Telegram apps for a TV (and Telegram's own
// desktop app) side by side, from src/data/alternatives.json, and an answer for the people who
// search for the older "TMP - Telegram Media Player". Facts only, each with the day it was
// checked and the listing it came from; no app is ranked, and the links to them are nofollow,
// since naming an app is not recommending it.
import StarBand from '../../../components/StarBand.astro';
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import Card from '../../../components/Card.astro';
import LinkCard from '../../../components/LinkCard.astro';
import DeviceShot from '../../../components/DeviceShot.astro';
import Action from '../../../components/guides/Action.astro';
import MoreHelp from '../../../components/guides/MoreHelp.astro';
import data from '../../../data/alternatives.json';
import vs from '../../../data/vs.json';
import { langPaths } from '../../../i18n/paths';
import { english, format, text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';
import { formatDay, lastmod } from '../../../lib/lastmod';
import { releases } from '../../../lib/releases';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
const a = (k: string) => `alternatives.${k}`;
const day = (d: string) => formatDay(lang, d);

interface Fact { k: string; day?: string; [name: string]: string | undefined }
interface App {
  name: string;
  developer: string;
  url: string;
  self?: boolean;
  also?: { label: string; url: string };
  kind: string;
  note?: string;
  platforms: string[];
  price: Fact;
  open: Fact;
  updated: Fact;
  stats?: Fact;
  checked: string;
}
// TMPlayer's own row names its latest release, so it never goes stale between checks.
const apps = (data.apps as App[]).map((x) =>
  x.self && releases[0] ? { ...x, updated: { ...x.updated, version: releases[0].version, day: releases[0].day } } : x,
);
const checked = day(data.checked);

// A fact cell: its catalog string with the row's values, dates in the page's language.
function fact(f: Fact): string {
  const vars: Record<string, string> = { checked };
  for (const [k, v] of Object.entries(f)) if (k !== 'k' && k !== 'day' && v) vars[k] = v;
  if (f.day) vars.date = day(f.day);
  return format(lang, a(f.k), vars);
}
// Platform names stay as they are; only the phones are words.
const platform = (p: string) => (['android_phones', 'phones', 'samsung_lg'].includes(p) ? t(a(`platform_${p}`)) : p);

const tevegram = data.apps.find((x) => x.name === 'Tevegram')!;
const tvForTelegram = data.apps.find((x) => x.name === 'tv for Telegram')!;
const tmp = data.apps.find((x) => x.name.startsWith('TMP '))!;
const nofollow = 'nofollow noopener';

const path = '/alternatives/';
const title = t(a('title'));
const description = t(a('description'));
const page = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: english[a('title')],
  description: english[a('description')],
  url: `https://tmplayer.org${path}`,
  dateModified: lastmod(path),
  inLanguage: 'en',
};
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: apps.map((x, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: x.name,
    url: x.self ? 'https://tmplayer.org/' : x.url,
  })),
};
---
<Base page="alternatives" title={title} description={description}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Alternatives', path])} />
    <JsonLd data={page} />
    <JsonLd data={itemList} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="alternatives" />

<main id="main">

  <PageHead lede={t(a('lede'))} updated={path}>
    <Fragment slot="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>{t(a('crumb'))}</Fragment>
    <T slot="title" k={a('h1')}><em slot="em1">{t(a('h1__em1'))}</em></T>
    <Fragment slot="actions">
      <Action filled href={l('/download/')}>{t('home.download_tmplayer')}</Action>
      <Action href="#compare">{t(a('see_the_table'))}</Action>
      <Action href="#tmp">{t(a('looking_for_tmp'))}</Action>
    </Fragment>
  </PageHead>

  <Band wave tonal id="kinds" title={t(a('kinds_title'))} sub={t(a('kinds_sub'))}>
    <div class="formats formats-3" data-reveal>
      <div class="format">
        <h3>{t(a('kind_client_h'))}</h3>
        <p>{t(a('kind_client_p'))}</p>
      </div>
      <div class="format">
        <h3>{t(a('kind_player_h'))}</h3>
        <p>{t(a('kind_player_p'))}</p>
      </div>
      <div class="format">
        <h3>{t(a('kind_cast_h'))}</h3>
        <p><T k={a('kind_cast_p')}><a href={l('/guides/telegram-on-tv-without-casting/')} slot="a1">{t(a('kind_cast_p__a1'))}</a></T></p>
      </div>
    </div>
    <p class="muted small section-note" data-reveal><T k={a('guides_note')}><a href={l('/guides/cast-telegram-videos-to-chromecast/')} slot="a1">{t(a('guides_note__a1'))}</a><a href={l('/guides/telegram-on-samsung-or-lg-tv/')} slot="a2">{t(a('guides_note__a2'))}</a></T></p>
  </Band>

  <Band wave id="tmp" title={t(a('tmp_title'))} sub={t(a('tmp_sub'))}>
    <div class="section-body prose-band" data-reveal>
      <p>{t(a('tmp_intro'))}</p>
      <ul class="fact-list">
        <li>{format(lang, a('tmp_fact_play'), { date: checked })}</li>
        <li>{format(lang, a('tmp_fact_archive'), { date: day('2020-10-06') })}</li>
        <li><T k={a('tmp_fact_amazon')}><a href={tmp.url} rel={nofollow} slot="a1">{t(a('tmp_fact_amazon__a1'))}</a></T></li>
      </ul>
      <h3>{t(a('tmp_move_h'))}</h3>
      <p>{t(a('tmp_move_p'))}</p>
      <p><a href="/alternatives/tmp-telegram-media-player/">{t(a('tmp_compare_link'))}</a></p>
    </div>
    <div class="shots alt-shots">
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-home.webp', light: '/screenshots/tv-home-light.webp', alt: t('home.tv_home_hero_alt'), width: 1920, height: 1080 }}><T k={a('shot_tv_home')}><b slot="b1">{t(a('shot_tv_home__b1'))}</b></T></DeviceShot>
    </div>
    <Cards>
      <LinkCard href={l('/guides/telegram-videos-on-android-tv/')} icon="tv-card" title={t('common.telegram_on_android_tv')} body={t('guides.install_tmplayer_on_an_android')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/guides/telegram-videos-on-fire-tv/')} icon="tv-card" title={t('common.telegram_on_fire_tv')} body={t('guides.install_tmplayer_on_a_fire')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/download/')} icon="play-card" title={t('home.download_tmplayer')} body={t(a('download_card'))} go={t('common.download')} />
    </Cards>
  </Band>

  <Band wave tonal id="compare" title={t(a('compare_title'))} sub={format(lang, a('checked_note'), { date: checked })}>
    {/* Scrolls on its own on a phone, so it takes focus for the keyboard and is named by its
        caption for a screen reader. */}
    <div class="compare-wrap" role="region" aria-labelledby="apps-caption" tabindex="0" data-reveal>
      <table class="compare compare-apps">
        <caption id="apps-caption">{format(lang, a('caption'), { count: apps.length })}</caption>
        <thead>
          <tr>
            <th scope="col">{t(a('col_app'))}</th>
            <th scope="col">{t(a('col_what'))}</th>
            <th scope="col">{t(a('col_platforms'))}</th>
            <th scope="col">{t(a('col_price'))}</th>
            <th scope="col">{t(a('col_open'))}</th>
            <th scope="col">{t(a('col_updated'))}</th>
          </tr>
        </thead>
        <tbody>
          {apps.map((x) => (
            <tr>
              <th scope="row">
                {x.self ? <a href={x.url} rel="noopener">{x.name}</a> : <a href={x.url} rel={nofollow}>{x.name}</a>}
                <span class="cell-note">{format(lang, a('by'), { developer: x.developer })}</span>
                {x.also && <span class="cell-note"><a href={x.also.url} rel={nofollow}>{format(lang, a('also_listing'), { store: x.also.label })}</a></span>}
              </th>
              <td>{t(a(`kind_${x.kind}`))}{x.note && <span class="cell-note">{t(a(x.note))}</span>}</td>
              <td>{x.platforms.map(platform).join(', ')}</td>
              <td>{fact(x.price)}</td>
              <td>{fact(x.open)}</td>
              <td>{fact(x.updated)}{x.stats && <span class="cell-note">{fact(x.stats)}</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small section-note" data-reveal>{t(a('table_note'))}</p>
  </Band>

  {/* One page per app people search for by name (src/pages/alternatives/[slug].astro), in English. */}
  <StarBand lede={t('android_tv.a_tv_app_outside_the')} />

  <Band wave id="one-by-one" title={t(a('one_h'))} sub={t(a('one_sub'))}>
    <Cards>
      {vs.pages.map((x) => <LinkCard href={`/alternatives/${x.slug}/`} icon="tv-card" title={x.id === 'telegram' ? t(a('one_telegram_h')) : x.name} body={t(a(`one_${x.id}`))} go={t(a('one_go'))} />)}
    </Cards>
  </Band>

  <Band wave tonal id="different"title={t(a('diff_title'))} sub={t(a('diff_sub'))}>
    <Cards>
      <Card title={t(a('diff_free_h'))}>{t(a('diff_free_p'))}</Card>
      <Card title={t(a('diff_open_h'))}>{t(a('diff_open_p'))}</Card>
      <Card title={t(a('diff_one_h'))}>{t(a('diff_one_p'))}</Card>
      <Card title={t(a('diff_server_h'))}>{t(a('diff_server_p'))}</Card>
    </Cards>
    {/* The one app on every screen, shown: the same demo library on a phone, a TV and a computer. */}
    <div class="shots alt-shots">
      <DeviceShot device="phone" shot={{ src: '/screenshots/phone-show.webp', light: '/screenshots/phone-show-light.webp', alt: t('home.phone_show_page_alt'), width: 1080, height: 2400 }}><T k={a('shot_phone')}><b slot="b1">{t(a('shot_phone__b1'))}</b></T></DeviceShot>
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-chats.webp', light: '/screenshots/tv-chats-light.webp', alt: t('android_tv.the_tmplayer_chat_list_on'), width: 1920, height: 1080 }}><T k={a('shot_tv')}><b slot="b1">{t(a('shot_tv__b1'))}</b></T></DeviceShot>
      <DeviceShot device="desktop" shot={{ src: '/screenshots/desktop-grid.webp', light: '/screenshots/desktop-grid-light.webp', alt: t('features.the_tmplayer_desktop_app_on'), width: 1920, height: 1200 }}><T k={a('shot_desktop')}><b slot="b1">{t(a('shot_desktop__b1'))}</b></T></DeviceShot>
    </div>
    <p class="muted small section-note" data-reveal><T k={a('diff_also')}><a href={l('/features/')} slot="a1">{t(a('diff_also__a1'))}</a></T></p>
  </Band>

  <Band wave id="apple-tv" title={t(a('apple_title'))}>
    <div class="section-body prose-band" data-reveal>
      <p>{t(a('apple_p1'))}</p>
      <p><T k={a('apple_p2')} vars={{ monthly: tevegram.price.monthly!, yearly: tevegram.price.yearly!, lifetime: tevegram.price.lifetime!, price: tvForTelegram.price.price! }}><a href={tevegram.also!.url} rel={nofollow} slot="a1">{tevegram.name}</a><a href={tvForTelegram.url} rel={nofollow} slot="a2">{tvForTelegram.name}</a></T></p>
    </div>
  </Band>

  <MoreHelp tonal>
    <T k="guide_no_casting.tmplayer_does_not_provide_media"><a href={l('/faq/')} slot="a1">{t('guide_no_casting.tmplayer_does_not_provide_media__a1')}</a></T>
  </MoreHelp>

</main>

<ToTop />

<Footer />
</Base>
