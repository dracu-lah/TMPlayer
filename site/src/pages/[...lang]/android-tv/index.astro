---
// Android TV: the product page, for "Telegram video player for Android TV". What the app is like
// on a television, the ten-foot layout, which devices it runs on, and the star card. The install
// step by step, with its troubleshooting and the HowTo JSON-LD, is the Android TV guide's.
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import { appLd } from '../../../lib/app-ld';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import Card from '../../../components/Card.astro';
import DeviceShot from '../../../components/DeviceShot.astro';
import Panel from '../../../components/Panel.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);


const shot = (name: string, alt: string, light = true) => ({
  src: `/screenshots/${name}.webp`,
  light: light ? `/screenshots/${name}-light.webp` : undefined,
  alt: t(alt),
  width: 960,
  height: 480,
});

// What changes on a television. The next-episode shot has no light twin and a smaller frame. The
// last row is text only, so the headings of each row line up.
const features = [
  { title: 'android_tv.a_rail_not_a_menu', body: 'android_tv.every_category_down_the_left', shot: shot('tv-rail', 'android_tv.rail_shot_alt') },
  { title: 'android_tv.sign_in_without_typing', body: 'android_tv.scan_a_qr_code_with', shot: shot('tv-sign-in', 'android_tv.sign_in_shot_alt') },
  { title: 'android_tv.voice_search_from_the_remote', body: 'android_tv.typos_and_missing_accents_still', shot: shot('tv-search', 'android_tv.search_shot_alt') },
  { title: 'android_tv.runs_on_a_1_gb', body: 'android_tv.built_on_a_mi_tv', icon: 'chip-large' },
  { title: 'android_tv.light_on_storage', body: 'android_tv.only_the_video_playing_is', icon: 'sd-card-large' },
  { title: 'android_tv.next_episode_on_its_own', body: 'android_tv.plays_the_next_episode_after', shot: { ...shot('tv-next-episode', 'android_tv.next_episode_shot_alt', false), width: 840, height: 420 } },
  { title: 'android_tv.home_rows_title', body: 'android_tv.home_rows_body' },
  { title: 'android_tv.heavy_title', body: 'android_tv.heavy_body' },
  { title: 'android_tv.stereo_title', body: 'android_tv.stereo_body' },
];
---
<Base page="android_tv" title={t('android_tv.tmplayer_a_telegram_video_player')} description={t('android_tv.a_free_open_source_telegram')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Android TV', '/android-tv/'])} />
    <JsonLd data={appLd()} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="android_tv" />

<main id="main">

  <PageHead lede={t('android_tv.designed_for_a_d_pad')}>
    <Fragment slot="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>Android TV</Fragment>
    <Fragment slot="title"><T k="android_tv.a_telegram_video_player"><em slot="em1">{t('android_tv.a_telegram_video_player__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/#android-tv')}> <Icon name="download-btn" /> {t('android_tv.download_for_android_tv')}</a>
      <a class="btn btn-outline" href={l('/guides/telegram-videos-on-android-tv/')}>{t('common.step_by_step_guide')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
  </PageHead>

    <Band wave tonal labelledby="tv-h" title={t('android_tv.what_changes_on_a_television')} sub={t('android_tv.same_account_same_apk_only')}>
    <Cards>
      {features.map((f) => <Card title={t(f.title)} body={t(f.body)} shot={f.shot} shotIcon={f.icon} />)}
    </Cards>
  </Band>

    <Band wave labelledby="tvshots-h" title={t('android_tv.the_ten_foot_layout')} sub={t('android_tv.the_app_on_a_television')}>
    <div class="shots">
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-chats.webp', light: '/screenshots/tv-chats-light.webp', alt: t('android_tv.the_tmplayer_chat_list_on'), width: 1920, height: 1080 }}><T k="android_tv.categories_on_the_rail_chats"><b slot="b1">{t('android_tv.categories_on_the_rail_chats__b1')}</b></T></DeviceShot>
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-grid.webp', light: '/screenshots/tv-grid-light.webp', alt: t('android_tv.videos_from_a_telegram_chat'), width: 1920, height: 1080 }}><T k="android_tv.running_time_and_size_on"><b slot="b1">{t('android_tv.running_time_and_size_on__b1')}</b></T></DeviceShot>
    </div>
  </Band>

    <StarBand lede={t('android_tv.a_tv_app_outside_the')} />

    <Band wave tonal labelledby="tvfit-h" title={t('android_tv.will_it_run_on_yours')}>
    <div class="two-col" data-reveal>
      <Panel kind="yes" title={t('android_tv.yes')}>
        <li>{t('android_tv.android_tv_and_google_tv')}</li>
        <li><T k="android_tv.sticks_with_fire_tv"><a href={l('/fire-tv/')} slot="a1">{t('android_tv.sticks_with_fire_tv__a1')}</a></T></li>
        <li>{t('android_tv.boxes_and_tvs_nvidia_shield')}</li>
        <li>{t('android_tv.32_bit_and_64_bit')}</li>
      </Panel>
      <Panel kind="no" title={t('android_tv.no')}>
        <li>{t('android_tv.not_samsung_tizen_not_lg')}</li>
        <li>{t('android_tv.not_apple_tv_and_not')}</li>
        <li>{t('android_tv.not_a_device_where_sideloading')}</li>
      </Panel>
    </div>

    <p class="muted small section-note" data-reveal><a href={l('/guides/telegram-videos-on-android-tv/')}>{t('guide_no_casting.install_the_apk_and_sign__a1')}</a><span class="sep" aria-hidden="true">&middot;</span><a href={l('/guides/telegram-videos-on-fire-tv/')}>{t('guide_no_casting.install_it_with_the_downloader__a1')}</a><span class="sep" aria-hidden="true">&middot;</span><a href={l('/guides/telegram-on-tv-without-casting/')}>{t('guide_no_casting.the_ways_to_get_telegram')}</a></p>
  </Band>

  <Icon name="wave-flip" />

  <GiveBand tonal />

</main>

<ToTop />

<Footer />
</Base>
