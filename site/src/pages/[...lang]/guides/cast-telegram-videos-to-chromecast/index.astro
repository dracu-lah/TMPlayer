---
// Casting the videos in your Telegram chats to a Chromecast or Google TV: TMPlayer's own casting
// step by step, what it handles, what it does not, and Telegram's Android app beside it. TMPlayer's
// facts come from the 1.27.0 and 1.27.1 release notes and the casting checkpoint (CP73) of the working plan; Telegram's from
// its own announcement of 7 March 2025, and nothing it does not say is claimed for it.
import StarBand from '../../../../components/StarBand.astro';
import GuidePage from '../../../../components/guides/GuidePage.astro';
import PageHead from '../../../../components/PageHead.astro';
import Crumbs from '../../../../components/guides/Crumbs.astro';
import Action from '../../../../components/guides/Action.astro';
import Band from '../../../../components/Band.astro';
import FitPanels from '../../../../components/guides/FitPanels.astro';
import Steps from '../../../../components/Steps.astro';
import Step from '../../../../components/Step.astro';
import Cards from '../../../../components/Cards.astro';
import Card from '../../../../components/Card.astro';
import LinkCard from '../../../../components/LinkCard.astro';
import DeviceShot from '../../../../components/DeviceShot.astro';
import MoreHelp from '../../../../components/guides/MoreHelp.astro';
import T from '../../../../components/T.astro';
import type { Guide } from '../../../../components/guides/ld';
import { langPaths } from '../../../../i18n/paths';
import { english, text } from '../../../../i18n/t';
import { l as link } from '../../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
const g = (k: string) => t(`guide_cast.${k}`);
const en = (k: string) => english[`guide_cast.${k}`];

const TELEGRAM_POST = 'https://telegram.org/blog/star-messages-gateway-2-0-and-more';

const steps = [1, 2, 3, 4].map((i) => ({ id: `cast-${i}`, name: en(`step_${i}_h`), text: en(`step_${i}_p`) }));
const ld: Guide = {
  path: '/guides/cast-telegram-videos-to-chromecast/',
  crumb: en('crumb'),
  headline: en('social_title'),
  description: en('description'),
  datePublished: '2026-10-19',
  howTo: { totalTime: 'PT2M', steps },
};

// What casting from TMPlayer handles, as cards: heading, then text.
const handles = ['mkv', 'audio', 'subs', 'res', 'drop', 'place'];

// Telegram's Android app beside TMPlayer: the row's heading, then each one's cell.
const table = [
  ['row_from', 'tg_from', 'tm_from'],
  ['row_to', 'tg_to', 'tm_to'],
  ['row_how', 'tg_how', 'tm_how'],
  ['row_handles', 'tg_handles', 'tm_handles'],
  ['row_price', 'tg_price', 'tm_price'],
];
---
<GuidePage page="guide_cast" title={g('title')} socialTitle={g('social_title')} description={g('description')} ld={ld}>

  <PageHead lede={g('lede')} updated={ld.path}>
    <Crumbs slot="crumbs" here={g('crumb')} />
    <T slot="title" k="guide_cast.h1"><em slot="em1">{g('h1__em1')}</em></T>
    <Fragment slot="actions">
      <Action filled href="#steps">{t('fire_tv.show_me_the_steps')}</Action>
      <Action href={l('/download/')}>{t('home.download_tmplayer')}</Action>
    </Fragment>
  </PageHead>

  <Band wave tonal id="fit" title={t('guide_android_tv.what_you_need')}>
    <FitPanels
      yes={{ title: t('guide_android_tv.you_need'), items: [g('need_1'), g('need_2'), g('need_3')] }}
      no={{ title: t('guide_android_tv.you_do_not_need'), items: [g('not_1'), g('not_2'), g('not_3')] }}
    />
  </Band>

  <Band wave body id="steps" title={g('steps_h')} sub={g('steps_sub')}>
    <Steps>
      {[1, 2, 3, 4].map((i) => (
        <Step id={`cast-${i}`} title={g(`step_${i}_h`)} p>{g(`step_${i}_p`)}</Step>
      ))}
    </Steps>
    <div class="shots alt-shots">
      <DeviceShot device="phone" shot={{ src: '/screenshots/phone-show.webp', light: '/screenshots/phone-show-light.webp', alt: t('home.phone_show_page_alt'), width: 1080, height: 2400 }}><T k="guide_cast.shot_phone"><b slot="b1">{g('shot_phone__b1')}</b></T></DeviceShot>
      <DeviceShot device="desktop" shot={{ src: '/screenshots/desktop-player.webp', alt: t('features.the_tmplayer_desktop_player_over'), width: 1920, height: 1200 }}><T k="guide_cast.shot_desktop"><b slot="b1">{g('shot_desktop__b1')}</b></T></DeviceShot>
    </div>
  </Band>

  <StarBand lede={t('features.every_feature_here_started_as')} />

  <Band wave tonal id="handles" title={g('handles_h')}>
    <Cards>
      {handles.map((h) => <Card title={g(`${h}_h`)}>{g(`${h}_p`)}</Card>)}
    </Cards>
    <div class="section-body prose-band" data-reveal>
      <p>{g('dlna_p')}</p>
    </div>
  </Band>

  <Band wave id="limits" title={g('limits_h')}>
    <div class="section-body prose-band" data-reveal>
      <ul class="fact-list">
        <li>{g('limit_airplay')}</li>
        <li>{g('limit_busy')}</li>
        <li>{g('limit_desktop')}</li>
      </ul>
    </div>
  </Band>

  <Band wave tonal id="telegram" title={g('telegram_h')}>
    <div class="section-body prose-band" data-reveal>
      <p><T k="guide_cast.telegram_p1"><a href={TELEGRAM_POST} rel="noopener" slot="a1">{g('telegram_p1__a1')}</a></T></p>
      <p>{g('telegram_p2')}</p>
    </div>

    {/* Scrolls on its own on a phone, so it takes focus for the keyboard and is named by its
        caption for a screen reader. */}
    <div class="compare-wrap" role="region" aria-labelledby="cast-caption" tabindex="0" data-reveal>
      <table class="compare">
        <caption id="cast-caption">{g('caption')}</caption>
        <thead>
          <tr>
            <th scope="col">{g('col_what')}</th>
            <th scope="col">Telegram (Android)</th>
            <th scope="col">TMPlayer</th>
          </tr>
        </thead>
        <tbody>
          {table.map(([row, tg, tm]) => (
            <tr>
              <th scope="row">{g(row)}</th>
              <td>{g(tg)}</td>
              <td>{g(tm)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small section-note" data-reveal><T k="guide_cast.table_note"><a href={TELEGRAM_POST} rel="noopener" slot="a1">{g('table_note__a1')}</a><a href="/changelog/1.27.0" slot="a2">1.27.0</a><a href="/changelog/1.27.1" slot="a3">1.27.1</a></T></p>
  </Band>

  <Band wave id="on-the-tv" title={g('tv_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('tv_p1')}</p>
      <p>{g('tv_p2')}</p>
    </div>
    <Cards>
      <LinkCard href={l('/guides/telegram-videos-on-android-tv/')} icon="tv-card" title={t('common.telegram_on_android_tv')} body={t('guides.install_tmplayer_on_an_android')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/guides/telegram-videos-on-fire-tv/')} icon="tv-card" title={t('common.telegram_on_fire_tv')} body={t('guides.install_tmplayer_on_a_fire')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/guides/telegram-on-samsung-or-lg-tv/')} icon="play-card" title={t('common.telegram_on_samsung_or_lg')} body={t('guides.samsung_lg_card')} go={t('guide_no_casting.compare_the_options')} />
    </Cards>
  </Band>

  <MoreHelp tonal>
    <T k="guide_cast.more"><a href={l('/guides/telegram-on-tv-without-casting/')} slot="a1">{g('more__a1')}</a><a href={l('/guides/telegram-on-samsung-or-lg-tv/')} slot="a2">{g('more__a2')}</a></T>
  </MoreHelp>

</GuidePage>
