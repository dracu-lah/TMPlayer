---
import StarBand from '../../../../components/StarBand.astro';
import GuidePage from '../../../../components/guides/GuidePage.astro';
import PageHead from '../../../../components/PageHead.astro';
import Crumbs from '../../../../components/guides/Crumbs.astro';
import Action from '../../../../components/guides/Action.astro';
import Band from '../../../../components/Band.astro';
import FitPanels from '../../../../components/guides/FitPanels.astro';
import Steps from '../../../../components/Steps.astro';
import Step from '../../../../components/Step.astro';
import Cards from '../../../../components/Cards.astro';
import Card from '../../../../components/Card.astro';
import Way from '../../../../components/Way.astro';
import DeviceShot from '../../../../components/DeviceShot.astro';
import FaqItem from '../../../../components/FaqItem.astro';
import MoreHelp from '../../../../components/guides/MoreHelp.astro';
import T from '../../../../components/T.astro';
import type { Guide } from '../../../../components/guides/ld';
import { langPaths } from '../../../../i18n/paths';
import { text } from '../../../../i18n/t';
import { l as link } from '../../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

const ld: Guide = {
  path: '/guides/telegram-videos-on-fire-tv/',
  crumb: 'Telegram videos on Fire TV',
  headline: 'How to watch Telegram videos on Fire TV',
  description: 'Step by step: install TMPlayer on a Fire TV Stick or Cube with the Downloader app, sign in with a QR code, play your Telegram videos, and fix a stuck install.',
  datePublished: '2026-10-06',
  howTo: {
    totalTime: 'PT10M',
    steps: [
      { id: 'fire-1', name: 'Check Fire OS', text: 'Fire OS 6 or newer, listed under Settings, My Fire TV, About.' },
      { id: 'fire-2', name: 'Install TMPlayer with Downloader', text: 'Turn on Developer options, install Downloader, let it install apps, then type tmplayer.org/apk into it and install TMPlayer.' },
      { id: 'fire-3', name: 'Sign in with a QR code', text: 'Open TMPlayer and scan the code: in Telegram on your phone, Settings, Devices, Link Desktop Device.' },
      { id: 'fire-4', name: 'Press play', text: 'Pick a chat, pick a video and press OK. It plays while it downloads.' },
    ],
  },
};
---
<GuidePage page="guide_fire_tv" title={t('guide_fire_tv.how_to_watch_telegram_videos')} socialTitle={t('guide_fire_tv.how_to_watch_telegram_videos_2')} description={t('guide_fire_tv.step_by_step_install_tmplayer')} ld={ld}>

  <PageHead lede={t('guide_fire_tv.amazon_s_store_has_no')} updated={ld.path}>
    <Crumbs slot="crumbs" here="Fire TV" />
    <T slot="title" k="guide_fire_tv.how_to_watch"><em slot="em1">{t('guide_fire_tv.how_to_watch__em1')}</em></T>
    <Fragment slot="actions">
      <Action filled href="#steps">{t('fire_tv.show_me_the_steps')}</Action>
      <Action href={l('/download/')}>{t('home.download_tmplayer')}</Action>
    </Fragment>
  </PageHead>

  <Band wave tonal id="fit" title={t('guide_fire_tv.will_it_work_on_yours')}>
    <FitPanels
      yes={{ title: t('guide_fire_tv.works_on'), items: [
        t('fire_tv.fire_tv_stick_stick_4k'),
        t('guide_fire_tv.the_same_universal_apk_as'),
      ] }}
      no={{ title: t('guide_fire_tv.does_not_work_on'), items: [
        t('guide_fire_tv.fire_os_6_and_older'),
        t('fire_tv.fire_tv_models_that_run'),
      ] }}
    />
  </Band>

  <Band wave body id="steps" title={t('guide_android_tv.four_steps')} sub={t('guide_fire_tv.about_ten_minutes_once_with')}>
    <Steps>
      <Step id="fire-1" title={t('guide_fire_tv.check_fire_os')}>
        <p><T k="guide_fire_tv.open_fire_os_7_or"><em slot="em1">{t('guide_fire_tv.open_fire_os_7_or__em1')}</em><em slot="em2">{t('guide_fire_tv.open_fire_os_7_or__em2')}</em><em slot="em3">{t('guide_fire_tv.open_fire_os_7_or__em3')}</em></T></p>
      </Step>
      <Step id="fire-2" title={t('guide_fire_tv.install_tmplayer_with_downloader')}>
        <p><T k="guide_fire_tv.downloader_apk"><em slot="em1">{t('guide_fire_tv.downloader_apk__em1')}</em><em slot="em2">Downloader</em><code slot="code1">tmplayer.org/apk</code></T></p>
        <p><T k="guide_fire_tv.the_five_steps_below_walk"><a href="#downloader" slot="a1">{t('guide_fire_tv.the_five_steps_below_walk__a1')}</a></T></p>
      </Step>
      <Step id="fire-3" title={t('guide_android_tv.sign_in_with_a_qr')}>
        <p><T k="guide_fire_tv.open_tmplayer_from_scan_the"><em slot="em1">{t('guide_fire_tv.open_tmplayer_from_scan_the__em1')}</em><em slot="em2">{t('guide_fire_tv.open_tmplayer_from_scan_the__em2')}</em><em slot="em3">{t('guide_fire_tv.open_tmplayer_from_scan_the__em3')}</em><em slot="em4">{t('guide_fire_tv.open_tmplayer_from_scan_the__em4')}</em></T></p>
        <div class="shots alt-shots step-shot">
          <DeviceShot device="tv" shot={{ src: '/screenshots/tv-sign-in.webp', alt: t('android_tv.sign_in_shot_alt'), width: 960, height: 480 }}>
            <T k="guide_fire_tv.sign_in_shot_caption"><b slot="b1">{t('guide_fire_tv.sign_in_shot_caption__b1')}</b></T>
          </DeviceShot>
        </div>
      </Step>
      <Step id="fire-4" title={t('guide_fire_tv.press_play')}>
        <p>{t('guide_fire_tv.move_through_your_chats_with')}</p>
      </Step>
    </Steps>
  </Band>

  <StarBand lede={t('install.if_these_steps_got_your')} />

  <Band wave tonal id="downloader" title={t('fire_tv.five_steps_with_the_remote')} sub={t('fire_tv.no_computer_needed_amazon_s')}>
    <div class="section-body" data-reveal>
      <Steps>
        <Step id="dl-1" title={t('fire_tv.turn_on_developer_options')}>
          <p><T k="fire_tv.open_and_press_ok_on"><em slot="em1">{t('fire_tv.open_and_press_ok_on__em1')}</em><em slot="em2">{t('fire_tv.open_and_press_ok_on__em2')}</em><em slot="em3">{t('fire_tv.open_and_press_ok_on__em3')}</em><em slot="em4">{t('fire_tv.open_and_press_ok_on__em4')}</em></T></p>
          <p><T k="fire_tv.if_is_already_listed_under"><em slot="em1">{t('fire_tv.if_is_already_listed_under__em1')}</em><em slot="em2">{t('fire_tv.if_is_already_listed_under__em2')}</em></T></p>
        </Step>
        <Step id="dl-2" title={t('fire_tv.install_downloader')}>
          <p><T k="fire_tv.go_to_then_type_and"><em slot="em1">{t('fire_tv.go_to_then_type_and__em1')}</em><em slot="em2">{t('fire_tv.go_to_then_type_and__em2')}</em><em slot="em3">Downloader</em><em slot="em4">{t('fire_tv.go_to_then_type_and__em4')}</em><em slot="em5">{t('fire_tv.go_to_then_type_and__em5')}</em></T></p>
        </Step>
        <Step id="dl-3" title={t('fire_tv.let_downloader_install_apps')}>
          <p><T k="fire_tv.back_in_open_and_turn"><em slot="em1">{t('fire_tv.back_in_open_and_turn__em1')}</em><em slot="em2">{t('fire_tv.back_in_open_and_turn__em2')}</em><em slot="em3">{t('fire_tv.back_in_open_and_turn__em3')}</em><em slot="em4">{t('fire_tv.back_in_open_and_turn__em4')}</em><em slot="em5">Downloader</em><em slot="em6">{t('fire_tv.back_in_open_and_turn__em6')}</em></T></p>
        </Step>
        <Step id="dl-4" title={t('fire_tv.fetch_the_apk')}>
          <p>{t('fire_tv.open_downloader_allow_it_access')}</p>
          <pre class="code"><code>tmplayer.org/apk</code></pre>
          <p><T k="fire_tv.press_go_the_apk"><em slot="em1">{t('fire_tv.press_go_the_apk__em1')}</em><em slot="em2">{t('fire_tv.press_go_the_apk__em2')}</em></T></p>
          <p class="muted small"><T k="install.tv_step2_code"><code slot="code1">3206503</code></T></p>
        </Step>
        <Step id="dl-5" title={t('fire_tv.open_it_and_sign_in')}>
          <p><T k="fire_tv.tmplayer_lands_under_the_icon"><em slot="em1">{t('fire_tv.tmplayer_lands_under_the_icon__em1')}</em><em slot="em2">{t('fire_tv.tmplayer_lands_under_the_icon__em2')}</em></T></p>
          <p><T k="fire_tv.open_it_and_scan_the"><em slot="em1">{t('fire_tv.open_it_and_scan_the__em1')}</em><em slot="em2">{t('fire_tv.open_it_and_scan_the__em2')}</em><em slot="em3">{t('fire_tv.open_it_and_scan_the__em3')}</em></T></p>
        </Step>
      </Steps>
    </div>
  </Band>

  <Band wave id="other-ways" title={t('fire_tv.or_with_a_computer_or')} sub={t('fire_tv.both_still_need_developer_options')}>
    <div class="section-body" data-reveal>
      <div class="formats">
        <Way title={t('fire_tv.adb_from_a_computer')}>
          <p><T k="fire_tv.turn_on_in_and_find"><em slot="em1">{t('fire_tv.turn_on_in_and_find__em1')}</em><em slot="em2">{t('fire_tv.turn_on_in_and_find__em2')}</em><em slot="em3">{t('fire_tv.turn_on_in_and_find__em3')}</em><em slot="em4">{t('fire_tv.turn_on_in_and_find__em4')}</em><em slot="em5">{t('fire_tv.turn_on_in_and_find__em5')}</em><em slot="em6">{t('fire_tv.turn_on_in_and_find__em6')}</em><a href={l('/download/#android-tv')} slot="a1">{t('fire_tv.turn_on_in_and_find__a1')}</a></T></p>
          <pre class="code"><code>adb connect &lt;fire-tv-ip&gt;:5555
adb install <span data-name="android-universal">TMPlayer-&lt;version&gt;-universal.apk</span></code></pre>
          <p>{t('fire_tv.accept_the_debugging_prompt_that')}</p>
        </Way>
        <Way title={t('fire_tv.send_files_to_tv')}>
          <p><T k="fire_tv.install_on_your_phone_and"><a href="https://play.google.com/store/apps/details?id=com.yablio.sendfilestotv" rel="noopener" slot="a1">{t('fire_tv.install_on_your_phone_and__a1')}</a><em slot="em1">{t('fire_tv.install_on_your_phone_and__em1')}</em></T></p>
        </Way>
      </div>
    </div>
  </Band>

  <Band wave tonal id="tips" title={t('guide_android_tv.worth_knowing')}>
    <Cards>
      <Card title={t('guide_fire_tv.keep_it_on_the_home')}><T k="guide_fire_tv.apps_from_outside_the_store"><em slot="em1">{t('guide_fire_tv.apps_from_outside_the_store__em1')}</em><em slot="em2">{t('guide_fire_tv.apps_from_outside_the_store__em2')}</em></T></Card>
      <Card title={t('fire_tv.updates_come_to_you')}>{t('guide_fire_tv.tmplayer_checks_for_new_versions')}</Card>
      <Card title={t('guide_fire_tv.low_memory_is_fine')}>{t('guide_fire_tv.it_is_tested_on_a')}</Card>
    </Cards>
  </Band>

  <Band wave id="trouble" title={t('install.if_it_goes_wrong')}>
    <div class="faq" data-reveal>
      <FaqItem q={t('fire_tv.there_is_no_install_unknown')}>{t('fire_tv.developer_options_is_still_hidden')}</FaqItem>
      <FaqItem q={t('fire_tv.it_says_there_was_a')}>{t('fire_tv.usually_the_fire_os_version')}</FaqItem>
      <FaqItem q={t('fire_tv.i_cannot_find_tmplayer_after')}><T k="fire_tv.apps_installed_from_outside_the"><em slot="em1">{t('fire_tv.apps_installed_from_outside_the__em1')}</em><em slot="em2">{t('fire_tv.apps_installed_from_outside_the__em2')}</em><em slot="em3">{t('fire_tv.apps_installed_from_outside_the__em3')}</em><em slot="em4">{t('fire_tv.apps_installed_from_outside_the__em4')}</em></T></FaqItem>
    </div>

    <p class="muted small section-note" data-reveal><T k="fire_tv.still_stuck_with_your_fire"><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a1">{t('fire_tv.still_stuck_with_your_fire__a1')}</a></T></p>
  </Band>

  <MoreHelp tonal download={{ href: l('/fire-tv/'), label: t('fire_tv.tmplayer_on_fire_tv') }}>
    <T k="guide_fire_tv.stuck_on_a_step_lists"><a href="#trouble" slot="a1">{t('guide_fire_tv.stuck_on_a_step_lists__a1')}</a><a href={l('/guides/telegram-videos-on-android-tv/')} slot="a2">{t('guide_fire_tv.stuck_on_a_step_lists__a2')}</a></T>
  </MoreHelp>

</GuidePage>
