---
// For the searches "telegram on samsung tv", "telegram lg tv", "telegram smart tv": an honest
// answer (neither Tizen nor webOS installs Android apps, TMPlayer's web app opens in their browser
// as a beta) and the ways that work, compared.
// Every brand claim here has a source (kept in the maintainer's SEO notes), checked on the date in `checked`.
import StarBand from '../../../../components/StarBand.astro';
import GuidePage from '../../../../components/guides/GuidePage.astro';
import PageHead from '../../../../components/PageHead.astro';
import Crumbs from '../../../../components/guides/Crumbs.astro';
import Action from '../../../../components/guides/Action.astro';
import Band from '../../../../components/Band.astro';
import Cards from '../../../../components/Cards.astro';
import Card from '../../../../components/Card.astro';
import LinkCard from '../../../../components/LinkCard.astro';
import DeviceShot from '../../../../components/DeviceShot.astro';
import MoreHelp from '../../../../components/guides/MoreHelp.astro';
import T from '../../../../components/T.astro';
import type { Guide } from '../../../../components/guides/ld';
import { langPaths } from '../../../../i18n/paths';
import { english, format, text } from '../../../../i18n/t';
import { l as link } from '../../../../i18n/links';
import { formatDay } from '../../../../lib/lastmod';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
const g = (k: string) => t(`guide_smart_tv.${k}`);
const n = (k: string) => t(`guide_no_casting.${k}`);
const checked = '2026-10-19';

// An explainer rather than a walkthrough, so an Article and no HowTo.
const ld: Guide = {
  path: '/guides/telegram-on-samsung-or-lg-tv/',
  crumb: english['guide_smart_tv.crumb'],
  headline: english['guide_smart_tv.social_title'],
  description: english['guide_smart_tv.description'],
  datePublished: '2026-10-19',
};

// The ways, as cards: heading, then text.
const ways = ['stick', 'app', 'cast', 'mirror', 'web'].map((w) => [`way_${w}_h`, `way_${w}_p`]);

// The same ways side by side: the row's heading, what it needs, what it asks of the phone, its
// catch. The mirroring and Telegram Web rows say what the no-casting guide says about them.
const table = [
  [g('way_stick_h'), g('row_stick_needs'), n('free_once_you_have_signed'), g('row_stick_catch')],
  [g('way_app_h'), g('row_app_needs'), n('free_once_you_have_signed'), g('row_app_catch')],
  [g('way_cast_h'), g('row_cast_needs'), g('row_cast_phone'), g('row_cast_catch')],
  [g('way_mirror_h'), g('row_mirror_needs'), n('it_stays_awake_on_the'), n('calls_and_notifications_show_on')],
  [g('way_web_h'), n('a_web_browser_on_the'), n('free_once_you_have_signed'), n('a_page_made_for_a')],
];
---
<GuidePage page="guide_smart_tv" title={g('title')} socialTitle={g('social_title')} description={g('description')} ld={ld}>

  <PageHead lede={g('lede')} updated={ld.path}>
    <Crumbs slot="crumbs" here={g('crumb')} />
    <T slot="title" k="guide_smart_tv.h1"><em slot="em1">{g('h1__em1')}</em></T>
    <Fragment slot="actions">
      <Action filled href="#compare">{n('compare_the_options')}</Action>
      <Action href={l('/download/')}>{t('home.download_tmplayer')}</Action>
    </Fragment>
  </PageHead>

  <Band wave tonal id="install" title={g('install_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('install_p1')}</p>
      <p>{g('install_p2')}</p>
    </div>
  </Band>

  <Band wave id="tmplayer-on-the-tv" title={g('app_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('app_p1')}</p>
      <p>{g('app_p2')}</p>
      <p><T k="guide_smart_tv.app_p3"><a href={l('/download/#tv-packages')} slot="a1">{g('app_p3__a1')}</a></T></p>
    </div>
  </Band>

  <Band wave tonal id="compare" title={g('options_h')} sub={g('options_sub')}>
    <div class="formats" data-reveal>
      {ways.map(([title, body]) => (
        <div class="format">
          <h3>{g(title)}</h3>
          <p>{g(body)}</p>
        </div>
      ))}
    </div>

    {/* Scrolls on its own on a phone, so it takes focus for the keyboard and is named by its
        caption for a screen reader. */}
    <div class="compare-wrap" role="region" aria-labelledby="compare-caption" tabindex="0" data-reveal>
      <table class="compare">
        <caption id="compare-caption">{g('caption')}</caption>
        <thead>
          <tr>
            <th scope="col">{n('way')}</th>
            <th scope="col">{t('guide_android_tv.what_you_need')}</th>
            <th scope="col">{n('your_phone')}</th>
            <th scope="col">{n('the_catch')}</th>
          </tr>
        </thead>
        <tbody>
          {table.map(([way, needs, phone, caveat]) => (
            <tr>
              <th scope="row">{way}</th>
              <td>{needs}</td>
              <td>{phone}</td>
              <td>{caveat}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Band>

  <StarBand lede={t('android_tv.a_tv_app_outside_the')} />

  <Band wave tonal id="cast" title={g('cast_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('cast_p')}</p>
      <ul class="fact-list">
        <li><T k="guide_smart_tv.cast_samsung"><b slot="b1">{g('cast_samsung__b1')}</b></T></li>
        <li><T k="guide_smart_tv.cast_lg"><b slot="b1">{g('cast_lg__b1')}</b></T></li>
      </ul>
      <p>{g('cast_check')}</p>
      <p>{g('cast_none')}</p>
    </div>
  </Band>

  <Band wave id="which" title={g('which_h')} sub={format(lang, 'guide_smart_tv.which_sub', { date: formatDay(lang, checked) })}>
    <Cards>
      <Card title={g('which_google_h')}>{g('which_google_p')}</Card>
      <Card title="Vizio">{g('which_vizio_p')}</Card>
      <Card title="Samsung">{g('which_samsung_p')}</Card>
      <Card title="LG">{g('which_lg_p')}</Card>
      <Card title={g('which_hdmi_h')}>{g('which_hdmi_p')}</Card>
    </Cards>
  </Band>

  <Band wave tonal id="mirroring" title={g('mirror_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('mirror_p')}</p>
    </div>
  </Band>

  <Band wave id="telegram-web" title={g('web_h')}>
    <div class="section-body prose-band" data-reveal>
      <p>{g('web_p')}</p>
    </div>
  </Band>

  <Band wave tonal id="pick" title={g('pick_h')}>
    <div class="section-body prose-band" data-reveal>
      <ul class="fact-list">
        <li><T k="guide_smart_tv.pick_stick"><b slot="b1">{g('pick_stick__b1')}</b></T></li>
        <li><T k="guide_smart_tv.pick_app"><b slot="b1">{g('pick_app__b1')}</b></T></li>
        <li><T k="guide_smart_tv.pick_cast"><b slot="b1">{g('pick_cast__b1')}</b></T></li>
        <li><T k="guide_smart_tv.pick_mirror"><b slot="b1">{g('pick_mirror__b1')}</b></T></li>
      </ul>
    </div>
    <div class="shots alt-shots">
      <DeviceShot device="tv" shot={{ src: '/screenshots/tv-home.webp', light: '/screenshots/tv-home-light.webp', alt: t('home.tv_home_hero_alt'), width: 1920, height: 1080 }}><T k="guide_smart_tv.shot"><b slot="b1">{g('shot__b1')}</b></T></DeviceShot>
    </div>
    <Cards>
      <LinkCard href={l('/guides/telegram-videos-on-android-tv/')} icon="tv-card" title={t('common.telegram_on_android_tv')} body={t('guides.install_tmplayer_on_an_android')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/guides/telegram-videos-on-fire-tv/')} icon="tv-card" title={t('common.telegram_on_fire_tv')} body={t('guides.install_tmplayer_on_a_fire')} go={t('features.read_the_steps')} />
      <LinkCard href={l('/guides/cast-telegram-videos-to-chromecast/')} icon="play-card" title={t('common.cast_to_chromecast')} body={t('guides.cast_card')} go={t('features.read_the_steps')} />
    </Cards>
  </Band>

  <MoreHelp>
    <T k="guide_smart_tv.more"><a href={l('/guides/telegram-on-tv-without-casting/')} slot="a1">{g('more__a1')}</a><a href={l('/faq/')} slot="a2">{g('more__a2')}</a></T>
  </MoreHelp>

</GuidePage>
