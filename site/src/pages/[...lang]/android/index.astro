---
// Android phones and tablets: the product page, for "Telegram video player for Android phones".
// What the app does on a phone, the screens, which phones run it, and the star card. The install,
// step by step, is the install page's; the APK is on the download page.
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import { appLd } from '../../../lib/app-ld';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import Card from '../../../components/Card.astro';
import DeviceShot from '../../../components/DeviceShot.astro';
import Panel from '../../../components/Panel.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

// What it does on a phone. Text cards: the site has large card glyphs only for storage and the
// chip, and a row of small glyphs on large tiles read as empty boxes.
const features = [
  { title: 'android.stream_title', body: 'android.stream_body' },
  { title: 'android.formats_title', body: 'android.formats_body' },
  { title: 'android.home_title', body: 'android.home_body' },
  { title: 'android.cast_title', body: 'android.cast_body' },
  { title: 'android.pip_title', body: 'android.pip_body' },
  { title: 'android.audio_title', body: 'android.audio_body' },
  { title: 'android.storage_title', body: 'android.storage_body' },
  { title: 'android.save_title', body: 'android.save_body' },
  { title: 'android.resume_title', body: 'android.resume_body' },
];
---
<Base page="android" title={t('android.title')} description={t('android.description')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Android', '/android/'])} />
    <JsonLd data={appLd()} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="android" />

<main id="main">

  <PageHead lede={t('android.lede')}>
    <Fragment slot="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>{t('download.android_phone')}</Fragment>
    <Fragment slot="title"><T k="android.heading"><em slot="em1">{t('android.heading__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/#android')}> <Icon name="download-btn" /> {t('android.download')}</a>
      <a class="btn btn-outline" href={l('/install/#android')}>{t('features.how_to_install')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
  </PageHead>

  <Band wave tonal labelledby="phone-h" title={t('android.what_it_does')} sub={t('android.what_it_does_sub')}>
    <Cards>
      {features.map((f) => <Card title={t(f.title)} body={t(f.body)} />)}
    </Cards>
  </Band>

  <Band wave labelledby="phoneshots-h" title={t('android.screens')} sub={t('android.screens_sub')}>
    <div class="shots">
      <DeviceShot device="phone" shot={{ src: '/screenshots/phone-chats.webp', light: '/screenshots/phone-chats-light.webp', alt: t('features.tmplayer_on_a_phone_listing'), width: 1080, height: 2400 }}><T k="features.every_chat_and_channel_you"><b slot="b1">{t('features.every_chat_and_channel_you__b1')}</b></T></DeviceShot>
      <DeviceShot device="phone" shot={{ src: '/screenshots/phone-grid.webp', light: '/screenshots/phone-grid-light.webp', alt: t('features.a_dense_grid_of_demo'), width: 1080, height: 2400 }}><T k="features.posters_with_the_year_size"><b slot="b1">{t('features.posters_with_the_year_size__b1')}</b></T></DeviceShot>
      <DeviceShot device="phone" shot={{ src: '/screenshots/phone-show.webp', light: '/screenshots/phone-show-light.webp', alt: t('home.phone_show_page_alt'), width: 1080, height: 2400 }}><T k="android.show_caption"><b slot="b1">{t('android.show_caption__b1')}</b></T></DeviceShot>
    </div>
  </Band>

  <StarBand lede={t('android.star_lede')} />

  <Band wave tonal labelledby="phonefit-h" title={t('android_tv.will_it_run_on_yours')}>
    <div class="two-col" data-reveal>
      <Panel kind="yes" title={t('android_tv.yes')}>
        <li>{t('android.yes_phones')}</li>
        <li>{t('android_tv.32_bit_and_64_bit')}</li>
        <li><T k="android.yes_tv"><a href={l('/android-tv/')} slot="a1">{t('android.yes_tv__a1')}</a></T></li>
      </Panel>
      <Panel kind="no" title={t('android_tv.no')}>
        <li>{t('desktop.no_iphone')}</li>
        <li>{t('android.no_play_store')}</li>
      </Panel>
    </div>
  </Band>

  <Icon name="wave-flip" />

  <GiveBand tonal />

</main>

<ToTop />

<Footer />
</Base>
