---
// Fire TV: the product page, for "Telegram video player for Fire TV". Whether a given Fire TV runs
// it, what it is like with the remote, and the download. The install itself, step by step with its
// troubleshooting and the HowTo JSON-LD, is the Fire TV guide's, so the two pages do not compete.
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import { appLd } from '../../../lib/app-ld';
import Band from '../../../components/Band.astro';
import Cards from '../../../components/Cards.astro';
import Panel from '../../../components/Panel.astro';
import Card from '../../../components/Card.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
---
<Base page="fire_tv" title={t('fire_tv.tmplayer_a_telegram_video_player')} description={t('fire_tv.a_free_open_source_telegram')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Fire TV', '/fire-tv/'])} />
    <JsonLd data={appLd()} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="fire_tv" />

<main id="main">

  <PageHead lede={t('fire_tv.fire_tv_sticks_the_fire')}>
    <Fragment slot="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>Fire TV</Fragment>
    <Fragment slot="title"><T k="android_tv.a_telegram_video_player"><em slot="em1">{t('fire_tv.for_fire_tv')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/#android-tv')}> <Icon name="download-btn" /> {t('fire_tv.download_for_fire_tv')}</a>
      <a class="btn btn-outline" href={l('/guides/telegram-videos-on-fire-tv/')}>{t('common.step_by_step_guide')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
  </PageHead>

    <Band wave tonal id="fit" labelledby="fit-h" title={t('android_tv.will_it_run_on_yours')} sub={t('fire_tv.tmplayer_needs_android_8_0')}>
    <div class="two-col" data-reveal>
      <Panel kind="yes" title={t('android_tv.yes')}>
        <li>{t('fire_tv.fire_tv_stick_stick_4k')}</li>
        <li>{t('fire_tv.the_one_universal_apk_the')}</li>
        <li>{t('fire_tv.the_tv_layout_the_remote')}</li>
      </Panel>
      <Panel kind="no" title={t('android_tv.no')}>
        <li>{t('fire_tv.fire_os_6_and_older')}</li>
        <li>{t('fire_tv.fire_tv_models_that_run')}</li>
      </Panel>
    </div>
  </Band>

    <StarBand lede={t('android_tv.a_tv_app_outside_the')} />

    <Band wave id="remote" labelledby="remote-h" title={t('fire_tv.the_remote_and_keeping_it')} sub={t('fire_tv.everything_works_from_the_fire')}>
    <Cards>
      <Card title={t('fire_tv.the_d_pad_does_it')}><T k="fire_tv.arrows_to_move_ok_to"><a href={l('/android-tv/')} slot="a1">{t('fire_tv.arrows_to_move_ok_to__a1')}</a></T></Card>
      <Card title={t('fire_tv.voice_search_where_fire_os')}>{t('fire_tv.tmplayer_s_own_search_can')}</Card>
      <Card title={t('fire_tv.updates_come_to_you')}>{t('guide_fire_tv.tmplayer_checks_for_new_versions')}</Card>
      <Card title={t('android_tv.runs_on_a_1_gb')}>{t('android_tv.built_on_a_mi_tv')}</Card>
      <Card title={t('android_tv.light_on_storage')}>{t('android_tv.only_the_video_playing_is')}</Card>
      <Card title={t('fire_tv.picture_title')}>{t('fire_tv.picture_body')}</Card>
    </Cards>
  </Band>

    <Band wave tonal id="install" labelledby="install-h" title={t('fire_tv.install_it_with_the_remote')} sub={t('fire_tv.no_computer_needed_amazon_s')}>
    <p class="muted small section-note" data-reveal><T k="fire_tv.the_guide_walks_through"><a href={l('/guides/telegram-videos-on-fire-tv/')} slot="a1">{t('fire_tv.the_guide_walks_through__a1')}</a></T></p>

    <DownloadCard more={{ href: l('/guides/telegram-videos-on-fire-tv/'), label: t('common.step_by_step_guide') }} />
  </Band>

  <GiveBand wave />

</main>

<ToTop />

<Footer />
</Base>
