---
// Windows, macOS and Linux: what the desktop app is, signing in and updates, a short install for
// each system, the main keyboard shortcuts, what it runs on, and the star card. The PC searches
// land here rather than on the home page.
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import { appLd } from '../../../lib/app-ld';
import Band from '../../../components/Band.astro';
import DeviceShot from '../../../components/DeviceShot.astro';
import Panel from '../../../components/Panel.astro';
import TickPanel from '../../../components/features/TickPanel.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);

// The features page's desktop lists, which already say what the window and the player do.
const desktopWindow = [
  'features.or_with_a_phone_number', 'features.home_history_favourites_downloads_sidebar',
  'features.to_play_restart_download_or', 'features.your_downloads_folder_unless_you',
  'features.size_and_position_a_second', 'desktop.window_panel', 'desktop.window_layout',
];
const desktopPlayer = [
  'features.mkv_mp4_avi_ts_image', 'features.and_seeks_without_waiting',
  'features.offers_the_next_episode_and', 'features.while_a_video_plays',
  'features.the_linux_desktop_s_media', 'desktop.player_cast', 'desktop.player_keys',
];
---
<Base page="desktop" title={t('desktop.title')} description={t('desktop.description')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Windows, macOS and Linux', '/desktop/'])} />
    <JsonLd data={appLd()} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="desktop" />

<main id="main">

  <PageHead lede={t('desktop.lede')}>
    <Fragment slot="crumbs"><a href={l('/')}>{t('common.home')}</a><span aria-hidden="true">/</span>{t('features.jump_windows_and_linux')}</Fragment>
    <Fragment slot="title"><T k="desktop.a_telegram_video_player"><em slot="em1">{t('desktop.a_telegram_video_player__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/#windows')}> <Icon name="download-btn" /> {t('common.download')}</a>
      <a class="btn btn-outline" href={l('/install/#windows')}>{t('features.how_to_install')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
    <nav class="platform-jump" aria-label={t('features.on_this_page')}>
      <a href="#windows">Windows</a>
      <a href="#macos">macOS</a>
      <a href="#linux">Linux</a>
      <a href="#keys">{t('features.jump_keyboard_shortcuts')}</a>
    </nav>
  </PageHead>

  <Band wave tonal labelledby="app-h" title={t('desktop.the_app_on_a_computer')} sub={t('features.the_same_account_library_and')}>
    <div class="shots">
      <DeviceShot device="desktop" shot={{ src: '/screenshots/desktop-grid.webp', light: '/screenshots/desktop-grid-light.webp', alt: t('features.the_tmplayer_desktop_app_on'), width: 1920, height: 1200 }}><T k="features.a_sidebar_and_a_grid"><b slot="b1">{t('features.a_sidebar_and_a_grid__b1')}</b></T></DeviceShot>
      <DeviceShot device="desktop" shot={{ src: '/screenshots/desktop-player.webp', alt: t('features.the_tmplayer_desktop_player_over'), width: 1920, height: 1200 }}><T k="features.played_through_mpv_with_the"><b slot="b1">{t('features.played_through_mpv_with_the__b1')}</b></T></DeviceShot>
    </div>
    <p class="muted small section-note" data-reveal>{t('desktop.built_with')}</p>
  </Band>

  <Band wave labelledby="does-h" title={t('home.what_it_does')}>
    <div class="two-col" data-reveal>
      <TickPanel icon="monitor-panel" tone="browse" title="features.the_window" items={desktopWindow} />
      <TickPanel icon="play-card" tone="play" title="features.the_player" items={desktopPlayer} />
    </div>
  </Band>

  <StarBand lede={t('desktop.star_lede')} />

  <Band wave tonal labelledby="sign-h" title={t('desktop.sign_in_and_updates')}>
    <div class="two-col" data-reveal>
      <Panel title={t('home.sign_in')}>
        <p>{t('home.sign_in_with_telegram_s')}</p>
        <p><T k="install.scan_the_qr_code_with"><em slot="em1">{t('install.scan_the_qr_code_with__em1')}</em><em slot="em2">{t('install.scan_the_qr_code_with__em2')}</em><em slot="em3">{t('install.scan_the_qr_code_with__em3')}</em><em slot="em4">{t('install.scan_the_qr_code_with__em4')}</em></T></p>
      </Panel>
      <Panel title={t('features.from_github_on_android_windows__strong1')}>
        <p>{t('desktop.updates')}</p>
      </Panel>
    </div>
  </Band>

  <Band wave labelledby="get-h" title={t('desktop.install_it')}>
    <div class="card-grid card-grid-3" data-reveal>
      <Panel id="windows" title="Windows">
        <p>{t('install.windows_10_or_11_64')}</p>
        <pre class="code"><code>irm https://tmplayer.org/install.ps1 | iex</code></pre>
        <p>{t('desktop.win_body')}</p>
        <p><a class="inline-link" href={l('/install/#windows')} aria-label={`${t('desktop.every_step')}: Windows`}>{t('desktop.every_step')}</a></p>
      </Panel>
      <Panel id="macos" title="macOS">
        <p>{t('desktop.mac_body')}</p>
        <p><T k="download.mac_dmg_note"><em slot="em1">{t('download.mac_dmg_note__em1')}</em><em slot="em2">{t('download.mac_dmg_note__em2')}</em><em slot="em3">{t('download.mac_dmg_note__em3')}</em><em slot="em4">{t('download.mac_dmg_note__em4')}</em></T></p>
        <p><a class="inline-link" href={l('/install/#macos')} aria-label={`${t('desktop.every_step')}: macOS`}>{t('desktop.every_step')}</a></p>
      </Panel>
      <Panel id="linux" title="Linux">
        <p>{t('download.x86_64_with_glibc_2')}</p>
        <p><T k="desktop.linux_body"><code slot="code1">makepkg -si</code></T></p>
        <p><a class="inline-link" href={l('/install/#linux')} aria-label={`${t('desktop.every_step')}: Linux`}>{t('desktop.every_step')}</a></p>
      </Panel>
    </div>
  </Band>

  {/* The shortcuts people look for first, checked against desktop/.../player/PlayerKeys.kt; the
      features page has the whole table. */}
  <Band wave tonal id="keys" title={t('features.desktop_keyboard_shortcuts')} sub={t('features.youtube_s_keys_plus_the')}>
    <div class="keys-wrap" data-reveal>
      <table class="keys">
        <thead>
          <tr><th scope="col">{t('features.to_do_this')}</th><th scope="col">{t('features.press')}</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">{t('features.play_or_pause')}</th><td><kbd>Space</kbd> <kbd>K</kbd>{t('features.or_click_the_picture')}</td></tr>
          <tr><th scope="row">{t('features.back_or_forward_5_seconds')}</th><td><kbd>&larr;</kbd> <kbd>&rarr;</kbd></td></tr>
          <tr><th scope="row">{t('features.back_or_forward_10_seconds')}</th><td><kbd>J</kbd> <kbd>L</kbd></td></tr>
          <tr><th scope="row">{t('features.back_or_forward_a_minute')}</th><td><kbd>Shift</kbd>+<kbd>&larr;</kbd> <kbd>Shift</kbd>+<kbd>&rarr;</kbd></td></tr>
          <tr><th scope="row">{t('features.volume')}</th><td><kbd>&uarr;</kbd> <kbd>&darr;</kbd>{t('features.or_the_wheel')}</td></tr>
          <tr><th scope="row">{t('features.mute')}</th><td><kbd>M</kbd></td></tr>
          <tr><th scope="row">{t('features.fullscreen')}</th><td><kbd>F</kbd> <kbd>F11</kbd></td></tr>
          <tr><th scope="row">{t('features.next_or_previous_subtitles_on')}</th><td><kbd>V</kbd> <kbd>Shift</kbd>+<kbd>V</kbd> <kbd>C</kbd></td></tr>
          <tr><th scope="row">{t('features.next_or_previous_audio_track')}</th><td><kbd>A</kbd> <kbd>Shift</kbd>+<kbd>A</kbd></td></tr>
          <tr><th scope="row">{t('features.next_or_previous_episode')}</th><td><kbd>Shift</kbd>+<kbd>N</kbd> <kbd>Shift</kbd>+<kbd>P</kbd></td></tr>
          <tr><th scope="row">{t('features.mini_player_in_the_corner')}</th><td><kbd>Ctrl</kbd>+<kbd>P</kbd></td></tr>
        </tbody>
      </table>
    </div>
    <p class="muted small section-note" data-reveal><T k="desktop.keys_note"><kbd slot="kbd1">?</kbd><a href={l('/features/#keys')} slot="a1">{t('desktop.keys_note__a1')}</a></T></p>
  </Band>

  <Band wave labelledby="fit-h" title={t('android_tv.will_it_run_on_yours')}>
    <div class="two-col" data-reveal>
      <Panel kind="yes" title={t('android_tv.yes')}>
        <li>{t('download.windows_10_and_11_64')}</li>
        <li>{t('desktop.yes_mac')}</li>
        <li>{t('desktop.yes_linux')}</li>
      </Panel>
      <Panel kind="no" title={t('android_tv.no')}>
        <li>{t('desktop.no_iphone')}</li>
        <li>{t('desktop.no_intel')}</li>
        <li>{t('desktop.no_arm_linux')}</li>
      </Panel>
    </div>
  </Band>

  <GiveBand wave tonal />

</main>

<ToTop />

<Footer />
</Base>
