---
// The stored theme is applied before the first paint, so a reader who chose light does not get a black flash on the way in. Nothing here decides a default: with no stored choice the attribute is never set and the stylesheet follows prefers-color-scheme, which is the system theme.
// The site's own shape, so a search engine can offer the five pages under the home page rather than the home page alone. Every entry here is a real page with its own copy on it.
// Who publishes the site: the logo and the profiles Google may show beside the site name.

import { LATEST_VERSION } from '../../lib/app-ld';
import Base from '../../layouts/Base.astro';
import BgArt from '../../components/BgArt.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToTop from '../../components/ToTop.astro';
import T from '../../components/T.astro';
import Icon from '../../components/Icon.astro';
import HeroStage from '../../components/home/HeroStage.astro';
import RunsOn from '../../components/home/RunsOn.astro';
import Bento from '../../components/home/Bento.astro';
import Trust from '../../components/home/Trust.astro';
import SetupSteps from '../../components/home/SetupSteps.astro';
import FaqTeaser from '../../components/home/FaqTeaser.astro';
import JsonLd from '../../components/JsonLd.astro';
import StarBand from '../../components/StarBand.astro';
import GiveBand from '../../components/GiveBand.astro';
import { langPaths } from '../../i18n/paths';
import { format, text } from '../../i18n/t';
import { DOWNLOADS, LANGUAGES, LATEST, PLATFORMS, compact } from '../../lib/stats';
import { l as link } from '../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);
// A headline longer than the English one (German, Russian, Arabic, Malayalam and others) is set a
// step smaller, so it keeps to two or three lines in the hero's column.
const heroTitleLength = t('home.your_telegram_videos').replace('{svg1} ', '').replace('{em1}', t('home.your_telegram_videos__em1')).length;

const ld0 = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "TMPlayer",
  "description": "A free, open source Telegram video player for Android TV, Android phones, Windows, macOS and Linux that streams the videos in your own chats.",
  "url": "https://tmplayer.org/",
  "image": "https://tmplayer.org/og.png?v=4",
  "screenshot": [
    "https://tmplayer.org/screenshots/tv-chats.webp",
    "https://tmplayer.org/screenshots/tv-home.webp",
    "https://tmplayer.org/screenshots/tv-grid.webp",
    "https://tmplayer.org/screenshots/phone-chats.webp",
    "https://tmplayer.org/screenshots/phone-grid.webp",
    "https://tmplayer.org/screenshots/phone-show.webp",
    "https://tmplayer.org/screenshots/desktop-grid.webp",
    "https://tmplayer.org/screenshots/desktop-player.webp"
  ],
  "applicationCategory": "MultimediaApplication",
  "applicationSubCategory": "Video player",
  "softwareVersion": LATEST_VERSION,
  "operatingSystem": "Android 6.0 and above (phones, Android TV, Google TV and Fire TV), Windows 10 and 11 (64-bit), Linux (x86_64), macOS 26 and newer on Apple Silicon (a preview), a web browser (web.tmplayer.org, a beta)",
  "downloadUrl": "https://tmplayer.org/download/",
  "installUrl": "https://tmplayer.org/install/",
  "softwareHelp": "https://tmplayer.org/faq/",
  "license": "https://www.gnu.org/licenses/gpl-3.0.html",
  "isAccessibleForFree": true,
  "inLanguage": "en",
  "featureList": [
    "Sign in to your own Telegram account by scanning a QR code",
    "Play videos straight from your chats and channels while they are still downloading",
    "Seeking re-aims the download instead of waiting for it",
    "Shows how much of the video has downloaded while the controls are up",
    "Optional download-the-whole-video-first mode for slow connections",
    "Plays MKV, MP4, AVI and TS with subtitles and multiple audio tracks",
    "Plays the next episode automatically, with a countdown you can stop",
    "Finds subtitles online through OpenSubtitles and, for Malayalam, MSone, and shifts subtitles or audio to match",
    "Groups series by season on their own page, with posters and overviews you can switch off",
    "Forgiving search that tolerates typos and missing accents",
    "Runs on TV sticks with 1 GB of RAM, and on Android phones",
    "Desktop app for Windows, macOS (Apple Silicon, a preview) and Linux, played through mpv, with YouTube style keyboard shortcuts"
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "dracu-lah",
    "url": "https://nevil.dev",
    "email": "hello@tmplayer.org",
    "sameAs": [
      "https://github.com/dracu-lah",
      "https://nevil.dev"
    ]
  },
  "sameAs": [
    "https://github.com/dracu-lah/TMPlayer",
    "https://t.me/tmplayerapp",
    "https://t.me/tmplayer_chat"
  ]
};

const ld1 = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "TMPlayer",
  "url": "https://tmplayer.org/",
  "inLanguage": "en",
  "hasPart": [
    {
      "@type": "WebPage",
      "name": "Features",
      "url": "https://tmplayer.org/features/"
    },
    {
      "@type": "WebPage",
      "name": "Download",
      "url": "https://tmplayer.org/download/"
    },
    {
      "@type": "WebPage",
      "name": "How to install",
      "url": "https://tmplayer.org/install/"
    },
    {
      "@type": "WebPage",
      "name": "Telegram video player for Android TV",
      "url": "https://tmplayer.org/android-tv/"
    },
    {
      "@type": "WebPage",
      "name": "Questions",
      "url": "https://tmplayer.org/faq/"
    },
    {
      "@type": "WebPage",
      "name": "Changelog",
      "url": "https://tmplayer.org/changelog/"
    }
  ],
  "publisher": {
    "@id": "https://tmplayer.org/#org"
  }
};

const ld2 = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://tmplayer.org/#org",
  "name": "TMPlayer",
  "url": "https://tmplayer.org/",
  "logo": "https://tmplayer.org/icon-512.png",
  "email": "hello@tmplayer.org",
  "founder": {
    "@type": "Person",
    "name": "dracu-lah",
    "url": "https://github.com/dracu-lah"
  },
  "sameAs": [
    "https://github.com/dracu-lah/TMPlayer",
    "https://t.me/tmplayerapp",
    "https://t.me/tmplayer_chat"
  ]
};
---
<Base page="home" title={t('home.tmplayer_free_unofficial_telegram_video')} description={t('home.stream_the_videos_in_your')} imageAlt={t('home.tmplayer_a_telegram_media_player')} secureImage feed>
  <Fragment slot="head">
    <JsonLd data={ld0} />
    <JsonLd data={ld1} />
    <JsonLd data={ld2} />
  </Fragment>
<!--
  Background art, hand drawn here rather than borrowed: four soft shapes, one per accent, anchored
  to the corners of the viewport and drifting very slowly. Decorative, hidden from assistive
  technology, and completely still under prefers-reduced-motion.
-->
<BgArt />

<Header page="home" brandSvg />

<main id="main">

  <!--
    The opening section is a split: the words and the one control on the start side, the
    television and three phones on the end side, so a visitor sees the app on the first screen
    instead of a column of text with the screenshots below the fold. Under 1080 px the stage drops
    beneath the words.
  -->
  <section class="hero" id="showcase" aria-labelledby="hero-h">
    <div class="wrap">
    <div class="hero-split">
    <div class="hero-inner">
      <!-- The latest release, from the release data the site is built with, so it is always the
           version the download button gives. The changelog is English only, like its link. -->
      {LATEST && <a class="news-pill" href={`/changelog/${LATEST.version}`}><span class="news-pill-tag">{format(lang, 'home.new_in', { version: LATEST.version })}</span><span class="news-pill-text">{t('home.see_whats_new')}</span><Icon name="arrow-right-sm" /></a>}

      <h1 id="hero-h" class:list={[{ 'hero-h-long': heroTitleLength > 34 }]}><T k="home.your_telegram_videos"><Icon name="h1-mark" slot="svg1" /><em slot="em1">{t('home.your_telegram_videos__em1')}</em></T>.</h1>
      <p class="lede">{t('home.hero_lede')}</p>

      <!-- The three figures, over the button they vouch for: worked out at build time by
           lib/stats.ts and drawn final in the first paint; app.js only counts them up once, as they
           come into view, and the hidden copy of each number holds its width. -->
      <ul class="stats" aria-label={t('home.stats_label')}>
        <li><b class="stat-n" data-count-to={DOWNLOADS}><span class="stat-ghost" aria-hidden="true">{compact(DOWNLOADS, lang.tag)}</span><span class="stat-live">{compact(DOWNLOADS, lang.tag)}</span></b> <span class="stat-label">{t('home.stat_downloads')}</span></li>
        <li><b class="stat-n" data-count-to={PLATFORMS}><span class="stat-ghost" aria-hidden="true">{compact(PLATFORMS, lang.tag)}</span><span class="stat-live">{compact(PLATFORMS, lang.tag)}</span></b> <span class="stat-label">{t('home.stat_platforms')}</span></li>
        <li><b class="stat-n" data-count-to={LANGUAGES}><span class="stat-ghost" aria-hidden="true">{compact(LANGUAGES, lang.tag)}</span><span class="stat-live">{compact(LANGUAGES, lang.tag)}</span></b> <span class="stat-label">{t('home.stat_languages')}</span></li>
      </ul>

      <!--
        One primary control, shaped like a command box rather than a plain button: the leading icon
        says what it does, the middle line is filled in from the GitHub release, and the pill on the
        right is the thing you press. app.js writes the href and the label.
      -->
      <a class="palette" id="hero-download" href={l('/download/')}>
        <span class="palette-icon" aria-hidden="true">
          <Icon name="download" />
        </span>
        <span class="palette-text" id="hero-download-label">{t('home.download_tmplayer')}</span>
        <span class="palette-go" aria-hidden="true">{t('home.get_it')} <Icon name="arrow-right" /> </span>
      </a>
    </div>

      <HeroStage />
    </div>
    </div>
  </section>

  <!--
    Below the hero the page answers, in order, what someone about to sideload an app checks: does
    it run on my device, what does it do once I press play, what does it do with my account, how
    long does setup take, and the doubts left over. Then the star.
  -->
  <RunsOn />
  <Bento />
  <!-- The star, between what the app does and what it does with your account: a stranger's
       sideloaded APK asks for trust, and the star count is the evidence others already gave it. -->
  <StarBand id="support" between fork={false} title={t('home.if_it_earned_its_place')} lede={t('home.a_star_takes_one_click')}>
    <p class="support-links" slot="links">
      <a href="https://t.me/tmplayerapp" rel="noopener"><Icon name="telegram-btn" /> {t('home.telegram_channel')}</a>
      <a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener"><Icon name="bug-btn" /> {t('home.report_a_problem')}</a>
    </p>
  </StarBand>
  <Trust />
  <SetupSteps />
  <!-- The support offer, once the reader has seen what setting it up takes (user, 2026-10-20: the
       star and the offer as separate cards between the sections, not one block at the end). -->
  <GiveBand between />
  <FaqTeaser />


</main>

<!--
  Back to top. A real button, so it is in the tab order and announces itself; app.js gives it the
  class that fades it in past the first screen and takes it away again at the foot of the page, so
  it never covers the legal text a reader has just scrolled to.
-->
<ToTop />

<Footer />
</Base>
