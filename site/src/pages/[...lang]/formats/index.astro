---
import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import JsonLd from '../../../components/JsonLd.astro';
import PageHead from '../../../components/PageHead.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import Card from '../../../components/Card.astro';
import Cards from '../../../components/Cards.astro';
import Panel from '../../../components/Panel.astro';
import KeysTable from '../../../components/formats/KeysTable.astro';
import KeysRow from '../../../components/formats/KeysRow.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);


// The kinds of message that show up in a chat's list, as title and text keys.
const listed = [
  ['formats.videos', 'formats.anything_telegram_sent_as_a'],
  ['formats.files_sent_as_documents', 'formats.films_are_often_sent_as'],
  ['formats.silent_clips', 'formats.the_short_looping_videos_telegram'],
];
---
<Base page="formats" title={t('formats.supported_formats_what_tmplayer_plays')} description={t('formats.the_containers_video_and_audio')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['Formats', '/formats/'])} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="formats" />

<main id="main">

  <PageHead lede={t('formats.on_android_tv_and_phones')}>
    <Fragment slot="crumbs"><T k="formats.formats"><a href={l('/')} slot="a1">{t('formats.formats__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></Fragment>
    <Fragment slot="title"><T k="formats.the_formats_it"><em slot="em1">{t('formats.the_formats_it__em1')}</em></T></Fragment>
    <nav class="platform-jump" aria-label={t('fire_tv.on_this_page')}>
      <a href="#listed">{t('formats.which_files_show_up')}</a>
      <a href="#android">{t('formats.android_tv_and_phones')}</a>
      <a href="#desktop">{t('formats.windows_and_linux')}</a>
      <a href="#subtitles">{t('formats.subtitle_files')}</a>
    </nav>
  </PageHead>

    <Band wave id="listed" labelledby="listed-h" tonal title={t('formats.which_files_show_up_in')} sub={t('formats.the_same_on_every_platform')}>
    <Cards>
      {listed.map(([title, body]) => <Card title={t(title)} body={t(body)} />)}
    </Cards>
  </Band>

    <StarBand lede={t('features.every_feature_here_started_as')} />

    <Band id="android" labelledby="android-h" title={t('formats.on_android_tv_and_phones_2')} sub={t('formats.the_device_s_own_decoders')}>
    <KeysTable>
      <KeysRow what={t('formats.containers')}>{t('formats.mkv_webm_mp4_m4v_mov')}</KeysRow>
      <KeysRow what={t('formats.video_h_264_hevc_h')}>{t('formats.yes_in_hardware_where_the')}</KeysRow>
      <KeysRow what={t('formats.video_av1_mpeg_4_part')}>{t('formats.through_the_device_s_own')}</KeysRow>
      <KeysRow what={t('formats.audio_aac_mp3_opus_vorbis')}>{t('formats.yes')}</KeysRow>
      <KeysRow what={t('formats.audio_dolby_digital_dolby_digital')}><T k="formats.sent_as_it_is_to"><em slot="em1">{t('formats.sent_as_it_is_to__em1')}</em></T></KeysRow>
      <KeysRow what={t('formats.several_audio_tracks')}>{t('formats.yes_switched_during_playback_and')}</KeysRow>
      <KeysRow what={t('formats.subtitles_inside_the_file')}>{t('formats.srt_ass_and_ssa_with')}</KeysRow>
      <KeysRow what="HDR">{t('formats.handed_to_the_device_s')}</KeysRow>
      <KeysRow what={t('formats.frame_rate_matching')}><T k="formats.on_android_tv_12_and"><em slot="em1">{t('formats.on_android_tv_12_and__em1')}</em><em slot="em2">{t('formats.on_android_tv_12_and__em2')}</em></T></KeysRow>
    </KeysTable>

    <div class="callout" data-reveal>
      <p><T k="formats.wmv_and_asf_realmedia_rmvb"><strong slot="strong1">{t('formats.wmv_and_asf_realmedia_rmvb__strong1')}</strong><em slot="em1">{t('formats.wmv_and_asf_realmedia_rmvb__em1')}</em></T></p>
    </div>
  </Band>

    <Band wave id="desktop" labelledby="desktop-h" tonal title={t('features.on_windows_and_linux')} sub={t('formats.the_desktop_app_plays_through')}>
    <KeysTable>
      <KeysRow what={t('formats.containers')}>{t('formats.every_one_in_the_list')}</KeysRow>
      <KeysRow what={t('formats.video')}><T k="formats.h_264_hevc_vp9_av1"><em slot="em1">{t('formats.h_264_hevc_vp9_av1__em1')}</em></T></KeysRow>
      <KeysRow what={t('formats.audio')}>{t('formats.aac_mp3_opus_vorbis_flac')}</KeysRow>
      <KeysRow what={t('formats.subtitles_inside_the_file')}>{t('formats.text_and_image_subtitles_alike')}</KeysRow>
      <KeysRow what={t('formats.several_audio_tracks')}>{t('formats.yes_from_the_right_click')}</KeysRow>
    </KeysTable>
  </Band>

    <Band wave id="subtitles" labelledby="subtitles-h" title={t('formats.subtitle_files_of_your_own')} sub={t('formats.for_a_video_whose_subtitles')}>
    <div class="two-col" data-reveal>
      <Panel title={t('formats.on_a_phone')}>
        <p><T k="formats.in_the_player_s_menu"><em slot="em1">{t('formats.in_the_player_s_menu__em1')}</em><code slot="code1">.srt</code><code slot="code2">.ass</code><code slot="code3">.ssa</code><code slot="code4">.vtt</code><code slot="code5">.sub</code></T></p>
      </Panel>
      <Panel title={t('features.on_windows_and_linux')}>
        <p><T k="formats.drop_the_file_on_the"><code slot="code1">.srt</code><code slot="code2">.ass</code><code slot="code3">.ssa</code><code slot="code4">.vtt</code><code slot="code5">.sub</code></T></p>
      </Panel>
    </div>
    <p class="muted small section-note" data-reveal><T k="formats.picture_based_vobsub_files_cannot"><code slot="code1">.sub</code></T></p>

    <DownloadCard />
  </Band>

  <GiveBand wave tonal />

</main>

<ToTop />

<Footer />
</Base>
