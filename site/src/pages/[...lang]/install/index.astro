---
// The stored theme, applied before the first paint. With no stored choice nothing is set and the stylesheet follows prefers-color-scheme, which is the system theme.

import Base from '../../../layouts/Base.astro';
import BgArt from '../../../components/BgArt.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ToTop from '../../../components/ToTop.astro';
import T from '../../../components/T.astro';
import Icon from '../../../components/Icon.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumb } from '../../../components/breadcrumb';
import Band from '../../../components/Band.astro';
import Steps from '../../../components/Steps.astro';
import TvCodes from '../../../components/TvCodes.astro';
import StarBand from '../../../components/StarBand.astro';
import GiveBand from '../../../components/GiveBand.astro';
import Step from '../../../components/Step.astro';
import SignIn from '../../../components/install/SignIn.astro';
import Way from '../../../components/Way.astro';
import Panel from '../../../components/Panel.astro';
import FaqItem from '../../../components/FaqItem.astro';
import Shot from '../../../components/Shot.astro';
import { SHOT_STEP_PIC } from '../../../components/shot-sizes';
import { langPaths } from '../../../i18n/paths';
import { text } from '../../../i18n/t';
import { l as link } from '../../../i18n/links';

export const getStaticPaths = langPaths;
const { lang } = Astro.props;
Astro.locals.lang = lang;
const t = (k: string) => text(lang, k);
const l = (href: string) => link(lang, href);


const ld1 = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to install TMPlayer on Android TV",
  "description": "Install TMPlayer on an Android TV or Google TV with the free Downloader app and the remote, then sign in to your own Telegram account.",
  "totalTime": "PT5M",
  "tool": [
    {
      "@type": "HowToTool",
      "name": "An Android TV or Google TV device running Android 6.0 or above"
    }
  ],
  "supply": [
    {
      "@type": "HowToSupply",
      "name": "The free Downloader app by AFTVnews"
    }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "name": "Install Downloader",
      "url": "https://tmplayer.org/install/#step-1",
      "text": "On the TV, open the Play Store, search for Downloader and install the free app by AFTVnews."
    },
    {
      "@type": "HowToStep",
      "name": "Type tmplayer.org/apk into Downloader",
      "url": "https://tmplayer.org/install/#step-2",
      "text": "Open Downloader, type tmplayer.org/apk into its address box and press Go. The latest TMPlayer APK starts downloading."
    },
    {
      "@type": "HowToStep",
      "name": "Allow the install",
      "url": "https://tmplayer.org/install/#step-3",
      "text": "When the TV asks, let Downloader install apps, then press Install. If there is no switch for it, press Build seven times under Settings, About, and try again."
    },
    {
      "@type": "HowToStep",
      "name": "Sign in",
      "url": "https://tmplayer.org/install/#step-4",
      "text": "Open TMPlayer and scan its QR code with Telegram on your phone: Settings, Devices, Link Desktop Device."
    }
  ]
};
---
<Base page="install" title={t('install.how_to_install_tmplayer_on')} description={t('install.description')}>
  <Fragment slot="head">
    <JsonLd data={breadcrumb(['How to install', '/install/'])} />
    <JsonLd data={ld1} />
  </Fragment>
{/* Decorative background art, hidden from assistive technology and still under reduced motion. */}
<BgArt />

<Header page="install" />

<main id="main" class="hp">

  <PageHead lede={t('install.on_a_tv_a_phone')}>
    <Fragment slot="crumbs"><T k="install.how_to_install"><a href={l('/')} slot="a1">{t('install.how_to_install__a1')}</a><span aria-hidden="true" slot="span1">/</span></T></Fragment>
    <Fragment slot="title"><T k="install.how_to_install_it"><em slot="em1">{t('install.how_to_install_it__em1')}</em></T></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-filled" href={l('/download/')}> <Icon name="download-btn" /> {t('install.all_downloads')}</a>
      <a class="btn btn-outline" href="https://github.com/dracu-lah/TMPlayer/blob/main/INSTALL.md" rel="noopener">{t('install.the_full_install_md')} <Icon name="arrow-right-sm" /></a>
    </Fragment>
    {/* One tile per platform, the visitor's own marked by app.js (a class only, so nothing moves). */}
    <nav class="install-pick" aria-label={t('download.platforms')}>
      <p class="install-pick-h">{t('install.pick_h')}</p>
      <div class="install-pick-row">
        <a href="#android-tv" data-os="android-tv"><Icon name="tv-card" /><span>Android TV</span></a>
        <a href="#android" data-os="android"><Icon name="phone-panel" /><span>{t('download.android_phone')}</span></a>
        <a href="#windows" data-os="windows"><Icon name="windows-panel" /><span>Windows</span></a>
        <a href="#macos" data-os="macos"><Icon name="laptop-panel" /><span>macOS</span></a>
        <a href="#linux" data-os="linux"><Icon name="terminal-panel" /><span>Linux</span></a>
        <a href="#smart-tv"><Icon name="tv-card" /><span>{t('install.smart_tv_tab')}</span></a>
      </div>
      <a class="install-pick-more" href="#shortcuts">{t('install.desktop_and_menu_shortcuts')}</a>
    </nav>
  </PageHead>

  <Band wave id="android-tv" labelledby="tv-h" title={t('install.tv_title')} tonal body>
    <T slot="sub" k="install.tv_sub"><a href={l('/guides/telegram-videos-on-fire-tv/')} slot="a1">{t('install.tv_sub__a1')}</a></T>
        <p class="step-time"><Icon name="tv-card" />{t('install.time_note')}</p>
        <Steps rail>
          <Step id="step-1" title={t('install.tv_step1_h')}>
            <p><T k="install.tv_step1"><em slot="em1">Downloader</em></T></p>
          </Step>
          <Step id="step-2" title={t('install.tv_step2_h')}>
            <p>{t('download.tv_s2')}</p>
            <TvCodes />
            <p><T k="install.tv_step2"><em slot="em1">{t('install.tv_step2__em1')}</em></T></p>
          </Step>
          <Step id="step-3" title={t('install.tv_step3_h')}>
            <p><T k="install.tv_step3"><em slot="em1">{t('install.tv_step3__em1')}</em><em slot="em2">{t('install.tv_step3__em2')}</em><em slot="em3">{t('install.tv_step3__em3')}</em><em slot="em4">{t('install.tv_step3__em4')}</em><em slot="em5">{t('install.tv_step3__em5')}</em><em slot="em6">{t('install.tv_step3__em6')}</em></T></p>
          </Step>
          <Step id="step-4" title={t('home.sign_in')}>
            <p><T k="install.tv_step4"><em slot="em1">{t('install.tv_step4__em1')}</em><em slot="em2">{t('install.tv_step4__em2')}</em><em slot="em3">{t('install.tv_step4__em3')}</em></T></p>
            <Shot frame="step-pic" src="/screenshots/tv-sign-in.webp" light="/screenshots/tv-sign-in-light.webp" alt={t('android_tv.sign_in_shot_alt')} width={960} height={480} sizes={SHOT_STEP_PIC} />
          </Step>
        </Steps>

        <h3 class="alt-head">{t('install.other_ways')}</h3>
        <div class="formats">
          <Way title={t('install.from_a_phone')}>
            <p><T k="install.tv_from_phone"><a class="inline-link" href="https://play.google.com/store/apps/details?id=com.yablio.sendfilestotv" target="_blank" rel="noopener" slot="a1"> <Icon name="external-link" />{t('install.tv_from_phone__a1')}</a></T></p>
          </Way>
          <Way title={t('install.from_a_computer')}>
            <p><T k="install.tv_from_computer_ip"><em slot="em1">{t('install.tv_from_computer_ip__em1')}</em><code slot="code1">&lt;tv-ip&gt;</code></T></p>
            <pre class="code"><code>adb connect &lt;tv-ip&gt;:5555
adb install <span data-name="android-universal">TMPlayer-&lt;version&gt;-universal.apk</span></code></pre>
            <p>{t('install.accept_the_debugging_prompt')}</p>
          </Way>
        </div>
  </Band>

  <Icon name="wave-flip" />

  <StarBand lede={t('install.if_these_steps_got_your')} />

  <Band id="android" labelledby="phone-h" title={t('install.phone_title')} sub={t('install.phone_sub')} body>
    <Steps rail>
      <Step id="phone-1" title={t('install.phone_step1_h')}>
        <p><T k="install.phone_step1"><a href={l('/download/')} slot="a1">{t('install.phone_step1__a1')}</a></T></p>
      </Step>
      <Step id="phone-2" title={t('install.phone_step2_h')}>
        <p><T k="install.phone_step2"><em slot="em1">{t('install.phone_step2__em1')}</em></T></p>
      </Step>
      <Step id="phone-3" title={t('home.sign_in')}>
        <p>{t('install.phone_step3')}</p>
      </Step>
    </Steps>
    <p class="muted small section-note"><T k="install.phone_obtainium"><a href="https://apps.obtainium.imranr.dev/redirect?r=obtainium://add/https://github.com/dracu-lah/TMPlayer" rel="noopener" slot="a1">Obtainium</a></T></p>
  </Band>

  <Band wave id="windows" labelledby="windows-h" title={t('install.on_windows')} sub={t('install.windows_10_or_11_64')} tonal body>
    <Steps rail>
      <Step id="win-1" title={t('install.win_step1_h')}>
        <p><T k="install.win_step1"><em slot="em1">{t('install.win_step1__em1')}</em><em slot="em2">{t('install.win_step1__em2')}</em></T></p>
      </Step>
      <Step id="win-2" title={t('install.win_step2_h')}>
        <pre class="code"><code>irm https://tmplayer.org/install.ps1 | iex</code></pre>
        <p>{t('install.win_step2_paste')}</p>
        <p><T k="install.win_step2_done"><a href="#windows-installer" slot="a1">{t('install.win_step2_done__a1')}</a></T></p>
      </Step>
      <Step id="win-3" title={t('install.win_step3_h')}>
        <p>{t('install.win_step3')}</p>
        <p><T k="install.scan_the_qr_code_with"><em slot="em1">{t('install.scan_the_qr_code_with__em1')}</em><em slot="em2">{t('install.scan_the_qr_code_with__em2')}</em><em slot="em3">{t('install.scan_the_qr_code_with__em3')}</em><em slot="em4">{t('install.scan_the_qr_code_with__em4')}</em></T></p>
      </Step>
    </Steps>

    <Panel id="windows-installer" title={t('install.win_msi_h')} wide>
      <p><T k="install.win_msi"><code data-name="windows-x64-msi" slot="code1">TMPlayer-&lt;version&gt;-windows-x64.msi</code><a href={l('/download/#windows')} slot="a1">{t('install.win_msi__a1')}</a><em slot="em1">{t('install.win_msi__em1')}</em><em slot="em2">{t('install.win_msi__em2')}</em><em slot="em3">{t('install.win_msi__em3')}</em></T></p>
    </Panel>
    <p class="muted small section-note">{t('install.win_zip_note')}</p>
  </Band>

  <Band wave id="macos" labelledby="macos-h" title={t('install.on_macos')} sub={t('install.macos_sub')} body>
    <Steps rail>
      <Step id="mac-1" title={t('install.mac_step1_h')}>
        <p><T k="install.mac_step1"><code slot="code1">TMPlayer-&lt;version&gt;-macos-arm64.dmg</code><a href={l('/download/#macos')} slot="a1">{t('install.mac_step1__a1')}</a><em slot="em1">TMPlayer</em><em slot="em2">{t('install.mac_step1__em2')}</em></T></p>
      </Step>
      <Step id="mac-2" title={t('install.mac_step2_h')}>
        <p><T k="install.mac_step2"><em slot="em1">{t('install.mac_step2__em1')}</em><em slot="em2">{t('install.mac_step2__em2')}</em></T></p>
        <p><T k="install.mac_step2b"><em slot="em1">{t('install.mac_step2b__em1')}</em><em slot="em2">{t('install.mac_step2b__em2')}</em><em slot="em3">{t('install.mac_step2b__em3')}</em><em slot="em4">{t('install.mac_step2b__em4')}</em><em slot="em5">{t('install.mac_step2b__em5')}</em></T></p>
        <p>{t('install.mac_terminal')}</p>
        <pre class="code"><code>xattr -dr com.apple.quarantine /Applications/TMPlayer.app</code></pre>
      </Step>
      <SignIn id="mac-3" />
    </Steps>

    <Panel id="macos-updates" title={t('install.mac_update_h')} wide>
      <p>{t('install.mac_update')}</p>
    </Panel>
    <p class="muted small section-note"><T k="install.mac_preview_note"><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a1">{t('install.mac_preview_note__a1')}</a></T></p>
  </Band>

  <Band wave id="linux" labelledby="linux-h" title={t('install.on_linux')} sub={t('download.x86_64_with_glibc_2')} tonal body>
    <Steps rail>
      <Step id="linux-1" title={t('install.linux_step1_h')}>
        <p><T k="install.linux_step1"><code data-name="linux-x64-appimage" slot="code1">TMPlayer-&lt;version&gt;-x86_64.AppImage</code><a href={l('/download/#linux')} slot="a1">{t('install.linux_step1__a1')}</a></T></p>
      </Step>
      <Step id="linux-2" title={t('install.linux_step2_h')}>
        <p>{t('install.linux_step2_where')}</p>
        <pre class="code"><code>cd ~/Downloads
chmod +x <span data-name="linux-x64-appimage">TMPlayer-&lt;version&gt;-x86_64.AppImage</span>
./<span data-name="linux-x64-appimage">TMPlayer-&lt;version&gt;-x86_64.AppImage</span></code></pre>
        <p><T k="install.or_tick_in_the_file"><em slot="em1">{t('install.or_tick_in_the_file__em1')}</em></T></p>
      </Step>
      <SignIn id="linux-3" />
    </Steps>

    <h3 class="alt-head">{t('install.other_ways')}</h3>
    <div class="formats">
      <Way title={t('download.arch_linux')}>
        <p><T k="install.arch_note"><a href="https://github.com/dracu-lah/TMPlayer/tree/main/desktop/packaging/aur" rel="noopener" slot="a1"><code>desktop/packaging/aur</code></a><code slot="code1">makepkg -si</code><code slot="code2">tmplayer</code></T></p>
      </Way>
      <Way title={t('install.tarball_h')}>
        <p><T k="install.tarball"><code data-name="linux-x64-tarball" slot="code1">TMPlayer-&lt;version&gt;-linux-x64.tar.xz</code><code slot="code2">bin/TMPlayer</code></T></p>
      </Way>
      <Way title={t('install.moving_from_the_deb_rpm')}>
        <p><T k="install.these_are_no_longer_published"><code slot="code1">sudo apt remove tmplayer</code><code slot="code2">sudo dnf remove tmplayer</code><code slot="code3">flatpak uninstall io.github.dracu_lah.TMPlayer</code><a href="https://github.com/dracu-lah/TMPlayer/blob/main/INSTALL.md#moving-from-a-format-that-is-no-longer-published" slot="a1">{t('install.these_are_no_longer_published__a1')}</a></T></p>
      </Way>
    </div>
    <p class="muted small section-note">{t('install.the_arch_package_adds_a')}</p>
  </Band>

  {/* Samsung and LG (a beta): the TV's browser, which web.tmplayer.org answers with its TV build.
      The release's .ipk and .wgt need a developer's setup, so they are on the download page and
      in the Samsung and LG guide, not here. */}
  <Band wave id="smart-tv" labelledby="smart-tv-h" title={t('install.smart_tv_title')} sub={t('install.smart_tv_sub')} body>
    <Steps rail>
      <Step id="smart-tv-1" title={t('install.smart_tv_step1_h')}>
        <p>{t('install.smart_tv_step1')}</p>
      </Step>
      <Step id="smart-tv-2" title={t('install.smart_tv_step2_h')}>
        <p>{t('install.smart_tv_step2')}</p>
      </Step>
      <Step id="smart-tv-3" title={t('home.sign_in')}>
        <p><T k="install.smart_tv_step3"><em slot="em1">{t('install.tv_step4__em1')}</em><em slot="em2">{t('install.tv_step4__em2')}</em><em slot="em3">{t('install.tv_step4__em3')}</em></T></p>
      </Step>
    </Steps>
    <p class="muted small section-note"><T k="install.smart_tv_note"><a href={l('/guides/telegram-on-samsung-or-lg-tv/#tmplayer-on-the-tv')} slot="a1">{t('install.smart_tv_note__a1')}</a></T></p>
  </Band>

  <Band wave id="shortcuts" labelledby="shortcuts-h" title={t('install.on_the_desktop_in_the')} sub={t('install.how_to_keep_it_one')} tonal body>
    <div class="two-col">
      <Panel title="Windows">
        <p><T k="install.win_pin"><em slot="em1">{t('install.win_pin__em1')}</em></T></p>
      </Panel>
      <Panel title={t('install.linux_the_arch_package')}>
        <p>{t('install.it_is_in_the_app')}</p>
        <p><strong>GNOME:</strong> <T k="install.right_click_it_in_activities"><em slot="em1">{t('install.right_click_it_in_activities__em1')}</em><strong slot="strong2">{t('install.right_click_it_in_activities__strong2')}</strong><em slot="em2">{t('install.right_click_it_in_activities__em2')}</em></T></p>
      </Panel>
    </div>

    <Panel title={t('install.linux_appimage_in_the_app')} wide>
      <p>{t('install.a_single_file_has_no')}</p>
      <details class="code-fold">
        <summary>{t('install.launcher_by_hand')}<Icon name="faq-chevron" /></summary>
      <pre class="code"><code>mkdir -p ~/Applications ~/.local/share/icons ~/.local/share/applications
mv ~/Downloads/<span data-name="linux-x64-appimage">TMPlayer-&lt;version&gt;-x86_64.AppImage</span> ~/Applications/TMPlayer.AppImage
chmod +x ~/Applications/TMPlayer.AppImage
curl -Lo ~/.local/share/icons/tmplayer.png https://tmplayer.org/icon-512.png

cat &gt; ~/.local/share/applications/tmplayer.desktop &lt;&lt;EOF
[Desktop Entry]
Type=Application
Name=TMPlayer
Comment=Telegram media player
Exec=$HOME/Applications/TMPlayer.AppImage
Icon=$HOME/.local/share/icons/tmplayer.png
Categories=AudioVideo;Video;Player;
Terminal=false
StartupWMClass=com-tmplayer-desktop-MainKt
EOF

chmod +x ~/.local/share/applications/tmplayer.desktop
update-desktop-database ~/.local/share/applications</code></pre>
      </details>
      <p>{t('install.then_pin_it_as_above')}</p>
      <p><T k="install.prefer_clicking_and_do_all"><a href="https://flathub.org/apps/it.mijorus.gearlever" rel="noopener" slot="a1">{t('install.prefer_clicking_and_do_all__a1')}</a><a href="https://github.com/TheAssassin/AppImageLauncher" rel="noopener" slot="a2">{t('install.prefer_clicking_and_do_all__a2')}</a></T></p>
    </Panel>

    <Panel title={t('install.linux_an_icon_on_the')} wide>
      <p>{t('install.copy_the_launcher_made_above')}</p>
      <pre class="code"><code>cp ~/.local/share/applications/tmplayer.desktop ~/Desktop/
chmod +x ~/Desktop/tmplayer.desktop
gio set ~/Desktop/tmplayer.desktop metadata::trusted true</code></pre>
      <p><T k="install.for_the_arch_package_copy"><code slot="code1">/usr/share/applications/io.github.dracu_lah.TMPlayer.desktop</code></T></p>
      <p><T k="install.gnome_needs_the_desktop_icons"><em slot="em1">{t('install.gnome_needs_the_desktop_icons__em1')}</em></T></p>
    </Panel>
  </Band>

  <Band wave labelledby="trouble-h" title={t('install.if_it_goes_wrong')} sub={t('install.the_fixes_for_nearly_every')}>
    <div class="faq" data-reveal>
      <FaqItem q={t('install.the_television_says_the_app')}>{t('install.unknown_sources_is_set_per')}</FaqItem>
      <FaqItem q={t('install.adb_connect_refuses_the_connection')}>{t('install.turn_on_network_debugging_use')}</FaqItem>
      <FaqItem q={t('install.the_qr_code_will_not')}>{t('install.stand_closer_and_hold_the')}</FaqItem>
      <FaqItem q={t('install.windows_shows_no_run_anyway')}><T k="install.click_first_a_work_computer"><em slot="em1">{t('install.click_first_a_work_computer__em1')}</em></T></FaqItem>
      <FaqItem q={t('install.the_appimage_does_nothing_when')}><T k="install.usually_fuse_is_missing_install"><code slot="code1">libfuse2t64</code><code slot="code2">libfuse2</code><code slot="code3">./<span data-name="linux-x64-appimage">TMPlayer-&lt;version&gt;-x86_64.AppImage</span> --appimage-extract-and-run</code></T></FaqItem>
      <FaqItem q={t('install.the_window_is_blank_or')}><T k="install.on_sway_i3_hyprland_and"><code slot="code1">_JAVA_AWT_WM_NONREPARENTING=1</code></T></FaqItem>
    </div>

    <p class="muted small section-note" data-reveal><T k="install.still_stuck_with_your_device"><a href="https://github.com/dracu-lah/TMPlayer/issues" rel="noopener" slot="a1">{t('install.still_stuck_with_your_device__a1')}</a></T></p>
  </Band>

  <GiveBand wave />

</main>

<ToTop />

<Footer />
</Base>
