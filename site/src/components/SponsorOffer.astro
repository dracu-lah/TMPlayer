---
// "Support TMPlayer": the coffee and sponsor links, in the same words as Settings and About in the
// app. Both take any amount and unlock nothing: the app stays whole and free whether or not anyone
// pays. Every content page carries the block, so a reader who got something from the page has the
// offer where they finished reading.
//
// Inside a star card it is one more block of the card. `slim` makes it a support-slim card of its
// own, for a page without a star card. `lede` replaces the line about ads, and the default slot goes
// under the buttons (the download page's QR codes).
//
// `short` adds one short line in the open under the heading, beside the tucked longer one (the
// landscape card, GiveLCard). `heading2` makes its heading an h2, for a support card that is a section of its own (GiveLCard on
// the home page).
//
// `release` is the slim card on the changelog and the release pages, which are English only and
// read by people who just got the update, the moment the offer makes the most sense. Its heading
// is an h2 in the notes' style, it is not revealed on scroll, and its line is the page's `lede`
// followed by the release sentence below.
//
// On the content pages the line about ads sits behind an info button beside the heading, so the
// offer is a heading and two links rather than a wall of text (user, 2026-10-18). It is a native
// <details>: the words stay in the HTML, so search engines index them as they did, it opens with
// a keyboard and a screen reader, and it works without scripting. The release cards and a page's
// own `lede` keep their line in the open, as does the support page, where it is the subject.
//
// Buy Me a Coffee comes first, as the large button in its own brand, and GitHub Sponsors is the
// quieter link under it (user, 2026-10-18). Between them, Pay by UPI: Buy Me a Coffee cannot take
// GPay or any other UPI app, which is how most readers here would pay (user, 2026-11-01). It is a
// real `upi://` link, so a phone opens its UPI app; app.js turns it into the UpiDialog (the QR and
// the ID to copy) on anything that cannot answer that link.
import Icon from './Icon.astro';
import CoffeeButton from './CoffeeButton.astro';
import UpiButton from './UpiButton.astro';
import { text } from '../i18n/t';
import { SPONSORS_URL } from '../lib/support';

interface Props { slim?: boolean; release?: boolean; lede?: string; heading2?: boolean; short?: string }
const { release = false, lede, heading2 = false, short } = Astro.props;
const slim = release || (Astro.props.slim ?? false);
const t = (k: string) => text(Astro.locals.lang, k);
const Card = slim ? 'div' : Fragment;
const card = slim ? { class: 'support support-slim', 'data-reveal': release ? undefined : '' } : {};
const H = release || heading2 ? 'h2' : 'h3';
const tucked = !release && lede === undefined;
const why = t('home.support_why');
const line = release
  ? `${lede} There are no ads of our own and no paid tier, so a coffee or a monthly sponsorship is what pays for the time each release takes. It is voluntary and unlocks nothing.`
  : lede ?? t('home.support_no_ads');
---
<Card {...card}>
<div class:list={['support-more', { 'support-more-solo': slim }]} id="sponsor">
  {tucked ? (
    <>
    <div class="support-head">
      <H>{t('home.support_tmplayer')}</H>
      <details class="support-why">
        <summary aria-label={why} title={why}><Icon name="info" /></summary>
        <p>{line}</p>
      </details>
    </div>
    {short && <p class="support-short">{short}</p>}
    </>
  ) : (
    <>
      <H class={release ? 'release-notes-h' : undefined}>{t('home.support_tmplayer')}</H>
      <p>{line}</p>
    </>
  )}
  <div class="support-coffee">
    <CoffeeButton label={t('home.buy_me_a_coffee')} large />
    <UpiButton label={t('home.pay_by_upi')} large />
    <a class="support-alt" href={SPONSORS_URL} rel="noopener"><Icon name="heart-btn" /> {t('home.sponsor_on_github')}</a>
  </div>
  <slot />
</div>
</Card>
