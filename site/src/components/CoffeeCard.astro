---
// The support card that floats at the bottom of the page's start edge (bottom left, bottom right on
// a right-to-left page). Asked for on 2026-10-18; revamped on 2026-11-01 to offer both ways to
// chip in: Google Pay (UPI, which is how most of the readers here pay) and Buy Me a Coffee (cards
// and PayPal).
//
// The card is written hidden and app.js shows it once the page has loaded and gone idle, with a
// short slide and fade (none under reduced motion). It is position: fixed, so it moves nothing
// when it arrives. It stands above the download bar on a phone. The x hides it for this page view
// only, on purpose: the next page or a reload brings it back, and nothing is stored.
//
// The two buttons are the site's own UpiButton and CoffeeButton, so they keep each brand's colours
// and behaviour: the UPI link opens a UPI app on a phone and UpiDialog (QR and ID) elsewhere, the
// coffee link opens CoffeeDialog. With scripting off, the card never appears. Every word is a
// catalog string, so it arrives translated.
import Icon from './Icon.astro';
import CoffeeButton from './CoffeeButton.astro';
import UpiButton from './UpiButton.astro';
import { text } from '../i18n/t';

const t = (k: string) => text(Astro.locals.lang, k);
const hide = t('home.bmc_hide');
---
<aside class="bmc-float" id="bmc-float" aria-label={t('home.support_tmplayer')} hidden>
  <div class="bmc-float-head">
    <div class="bmc-float-text">
      <p class="bmc-float-title">{t('home.bmc_card_title')}</p>
      <p class="bmc-float-line">{t('home.bmc_card_line')}</p>
    </div>
    <button type="button" class="bmc-float-close" data-bmc-hide aria-label={hide} title={hide}><Icon name="close" /></button>
  </div>
  <div class="bmc-float-actions">
    <UpiButton label={t('home.bmc_card_upi')} />
    <CoffeeButton label={t('home.bmc_card_coffee')} />
  </div>
</aside>
