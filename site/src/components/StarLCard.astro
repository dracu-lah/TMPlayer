---
// The star, as a landscape card in the site's own blue: the words on the start side, the live
// counts and the button on the end side (one column on a phone). StarCard puts it at the foot of a
// content page; the home page sets it between its own sections (user, 2026-10-20). The counts are
// filled in by app.js from GitHub and stay hidden when GitHub does not answer.
import Icon from './Icon.astro';
import { text } from '../i18n/t';

interface Props { title: string; lede: string }
const t = (k: string) => text(Astro.locals.lang, k);
const { title, lede } = Astro.props;
---
<div class="lcard lcard-star" data-reveal>
  <div class="lcard-text">
    <h2 id="support-h">{title}</h2>
    <p>{lede}</p>
    <slot name="links" />
  </div>
  <div class="lcard-side">
    <p class="lcard-figures">
      <span data-count-wrap hidden><b data-count="stars"></b> {t('home.stars')}</span>
      <span data-count-wrap hidden><b data-count="forks"></b> {t('home.forks')}</span>
    </p>
    <a class="btn btn-filled" href="https://github.com/dracu-lah/TMPlayer" rel="noopener"><Icon name="star-btn" /> {t('home.star_on_github')}</a>
  </div>
</div>
