---
// "Support TMPlayer" as a landscape card in Buy Me a Coffee's near-black, so their yellow button
// keeps its own colours and stands out: the heading and one short line on the start side, the
// coffee button and the sponsor link on the end side (one column on a phone). It is SponsorOffer
// inside, so the offer's words, links and rules stay in one place; the default slot is free for a
// caller that needs to add something under the buttons.
import Icon from './Icon.astro';
import SponsorOffer from './SponsorOffer.astro';
import { text } from '../i18n/t';

interface Props { heading2?: boolean }
const { heading2 = false } = Astro.props;
const t = (k: string) => text(Astro.locals.lang, k);
---
<div class="lcard lcard-give" data-reveal>
  <div class="cover-icon-row">
    <div class="cover-icon icon-play"><Icon name="heart-btn" /></div>
    <div class="cover-icon-body">
      <SponsorOffer short={t('home.support_line')} heading2={heading2}><slot /></SponsorOffer>
    </div>
  </div>
</div>
