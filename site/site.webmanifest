{
  "name": "TMPlayer",
  "short_name": "TMPlayer",
  "description": "An open source Android TV app that signs into your own Telegram account by QR code and streams the videos already in your chats.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "orientation": "landscape",
  "categories": ["utilities", "video"],
  "background_color": "#0E0E12",
  "theme_color": "#0E0E12",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/tv-chats.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The chat list on a television, with favourites, channels and groups"
    },
    {
      "src": "/screenshots/tv-grid.webp",
      "sizes": "1920x1080",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Playable videos in a Telegram chat, on a television"
    },
    {
      "src": "/screenshots/phone-chats.webp",
      "sizes": "1080x2400",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The chat list on a phone"
    },
    {
      "src": "/screenshots/phone-grid.webp",
      "sizes": "1080x2400",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Playable videos in a Telegram chat, on a phone"
    }
  ]
}
